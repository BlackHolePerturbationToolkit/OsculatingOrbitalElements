Notebook[{
Cell["Force", "ObjectName"],

Cell[TextData[{
 Cell[BoxData["Force"], "InlineFormula"],
 "\[LineSeparator]",
 "Force is an option for SchwarzOsculatingOrbitalElements and \
KerrOsculatingOrbitalElements which specifies the model to use when solving \
the oscualting goedesic euqaitons. \nBy default, the appropriate Gas Drag \
model is used. \nOne can replace this with the name of any of the included \
models, or provide functions for each component. "
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[Cell[BoxData[
 ButtonBox["OsculatingInspiral",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], \
"InlineSeeAlsoFunction"]], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell["Metadata", "MetadataSection"],

Cell[TextData[{
 "New in: ",
 Cell["0.1", "HistoryData",
  CellTags->"New"],
 " | Modified in: ",
 Cell[" ", "HistoryData",
  CellTags->"Modified"],
 " | Obsolete in: ",
 Cell[" ", "HistoryData",
  CellTags->"Obsolete"]
}], "History"],

Cell[CellGroupData[{

Cell["Categorization", "CategorizationSection"],

Cell["Symbol", "Categorization",
 CellLabel->"Entity Type"],

Cell["OsculatingOrbitalElements", "Categorization",
 CellLabel->"Paclet Name"],

Cell["OsculatingOrbitalElements`", "Categorization",
 CellLabel->"Context"],

Cell["OsculatingOrbitalElements/ref/Force", "Categorization",
 CellLabel->"URI"]
}, Closed]],

Cell[CellGroupData[{

Cell["Keywords", "KeywordsSection"],

Cell["osculating orbital elements", "Keywords"],

Cell["inspiral", "Keywords"],

Cell["Kerr", "Keywords"]
}, Closed]]
