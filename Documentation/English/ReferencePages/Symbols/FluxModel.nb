Cell[CellGroupData[{

Cell["More Examples", "ExtendedExamplesSection"],

Cell[CellGroupData[{

Cell["Scope", "ExampleSection"],

Cell["A custom flux of p, e and x:", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"custom", "=", 
   RowBox[{"FluxModel", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "p", ",", "e", ",", "x"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["10", 
           SuperscriptBox["p", "3"]]}], ",", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"10", " ", "e"}], 
           SuperscriptBox["p", "4"]]}], ",", "0"}], "}"}]}], "]"}], ",", 
     RowBox[{"\"\<Name\>\"", "\[Rule]", "\"\<Simple\>\""}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OsculatingInspiral", "[", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", "0.5`"}], ",", 
     RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "2"]]}], ",", 
     RowBox[{"\"\<p\>\"", "\[Rule]", "12"}], ",", 
     RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
     RowBox[{"\"\<x\>\"", "\[Rule]", "0.7`"}], ",", 
     RowBox[{"\"\<Flux\>\"", "\[Rule]", "custom"}]}], "]"}], "]"}], "[", 
  "\"\<Domain\>\"", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "50405.440732040166`"}], "}"}]], "Output"],

Cell["\<\
The orbit average of a force, here gas drag on an equatorial orbit:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"drag", "=", 
   RowBox[{"ForceModel", "[", 
    RowBox[{"\"\<GasDrag\>\"", ",", 
     RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "4"]]}]}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"averaged", "=", 
  RowBox[{"FluxModel", "[", "drag", "]"}]}]], "Input"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["FluxModel",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Name: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox["\"OrbitAverage[GasDrag]\"", "SummaryItem"]}]}, {
