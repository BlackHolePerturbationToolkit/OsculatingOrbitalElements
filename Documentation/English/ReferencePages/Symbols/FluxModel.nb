            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxCloser"]], 
              ButtonFunction :> (Typeset`open$$ = False), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Name: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox["\"OrbitAverage[GasDrag]\"", "SummaryItem"]}]}, {
               RowBox[{
                 TagBox["\"Parameters: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  RowBox[{"\[LeftAssociation]", 
                    RowBox[{"\"Points\"", "\[Rule]", "16"}], 
                    "\[RightAssociation]"}], "SummaryItem"]}]}, {
               RowBox[{
                 TagBox[
                 "\"Scales with mass ratio: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox["False", "SummaryItem"]}]}, {
               RowBox[{
                 TagBox["\"Rates of: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  RowBox[{"{", 
                    RowBox[{"\"En\"", ",", "\"L\"", ",", "\"Q\""}], "}"}], 
                  "SummaryItem"]}]}, {
               RowBox[{
                 TagBox["\"Description: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                 "\"The force GasDrag averaged over the radial and polar \
motion of the geodesic, with respect to t\"", "SummaryItem"]}]}, {
               RowBox[{
                 TagBox["\"Citation: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                 "\"J. R. Gair, E. E. Flanagan, S. Drasco, T. Hinderer and S. \
Babak, Forced motion near black holes, arXiv:1012.5111, Appendix D\"", 
                  "SummaryItem"]}]}}, 
             GridBoxAlignment -> {
              "Columns" -> {{Left}}, "Rows" -> {{Automatic}}}, AutoDelete -> 
             False, 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
             GridBoxSpacings -> {"Columns" -> {{2}}, "Rows" -> {{Automatic}}},
              BaseStyle -> {
              ShowStringCharacters -> False, NumberMarks -> False, 
               PrintPrecision -> 3, ShowSyntaxStyles -> False}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}, "Rows" -> {{Top}}}, 
          AutoDelete -> False, 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
          BaselinePosition -> {1, 1}]}, 
       Dynamic[Typeset`open$$], ImageSize -> Automatic]},
     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  OsculatingOrbitalElements`FluxModel[<|
   "Name" -> "OrbitAverage[GasDrag]", "Description" -> 
    "The force GasDrag averaged over the radial and polar motion of the \
geodesic, with respect to t", "Function" -> 
    Function[{
      OsculatingOrbitalElements`Private`a$, 
       OsculatingOrbitalElements`Private`p$, 
       OsculatingOrbitalElements`Private`e$, 
       OsculatingOrbitalElements`Private`x$, 
       OsculatingOrbitalElements`Private`parameters$}, 
      OsculatingOrbitalElements`Private`orbitAveragedRates[
       OsculatingOrbitalElements`ForceModel[<|
        "Name" -> "GasDrag", "Description" -> 
         "Relativistic gas drag, F_\[Mu] = -k (u_\[Mu] + \
\[Delta]^t_\[Mu]/u^t), with k the Coefficient", "Function" -> 
         OsculatingOrbitalElements`Private`gasDragComponents, 
         "ScalesWithMassRatio" -> False, "ValidityCondition" -> (True& ), 
         "ValidityDescription" -> None, "Citation" -> 
         "J. R. Gair, E. E. Flanagan, S. Drasco, T. Hinderer and S. Babak, \
Forced motion near black holes, arXiv:1012.5111, Appendix D", 
         "Parameters" -> <|"Coefficient" -> Rational[1, 10000]|>|>], 
       OsculatingOrbitalElements`Private`a$, 
       OsculatingOrbitalElements`Private`p$, 
       OsculatingOrbitalElements`Private`e$, 
       OsculatingOrbitalElements`Private`x$, 
       OsculatingOrbitalElements`Private`parameters$["Points"]]], 
    "ScalesWithMassRatio" -> False, "ValidityCondition" -> (True& ), 
    "ValidityDescription" -> None, "Citation" -> 
    "J. R. Gair, E. E. Flanagan, S. Drasco, T. Hinderer and S. Babak, Forced \
motion near black holes, arXiv:1012.5111, Appendix D", 
    "Rates" -> {"En", "L", "Q"}, "Parameters" -> <|"Points" -> 16|>|>],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"forced", ",", "fluxed"}], "}"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"OsculatingInspiral", "[", 
       RowBox[{
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<a\>\"", "\[Rule]", "0.5`"}], ",", 
          RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
           FractionBox["1", 
            SuperscriptBox["10", "4"]]}], ",", 
          RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
          RowBox[{"\"\<e\>\"", "\[Rule]", "0.2`"}], ",", 
          RowBox[{"\"\<x\>\"", "\[Rule]", "1"}], ",", "#1"}], "]"}], ",", 
        RowBox[{"IntegrationLimit", "\[Rule]", "1000"}]}], "]"}], "&"}], 
     ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Force\>\"", "\[Rule]", "drag"}], ",", 
      RowBox[{"\"\<Flux\>\"", "\[Rule]", "averaged"}]}], "}"}]}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"forced", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"fluxed", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<force\>\"", ",", "\"\<averaged flux\>\""}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<e\>\""}], "}"}]}]}], "]"}]], "Input"],

