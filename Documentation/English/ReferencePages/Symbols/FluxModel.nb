 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Examples", "PrimaryExamplesSection"],

Cell["Peters' leading-order rates of p, e and x at a point:", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FluxModel", "[", "\"\<Peters\>\"", "]"}], "[", 
  RowBox[{"0.9`", ",", "12", ",", "0.3`", ",", "0.7`"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.00693663956526639`"}], ",", 
   RowBox[{"-", "0.0002636489031366759`"}], ",", "0"}], "}"}]], "Output"],

Cell["An inspiral driven by them:", "ExampleText"],

Cell[BoxData[
 RowBox[{"peters", "=", 
  RowBox[{"OsculatingInspiral", "[", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
     RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "2"]]}], ",", 
     RowBox[{"\"\<p\>\"", "\[Rule]", "12"}], ",", 
     RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
     RowBox[{"\"\<x\>\"", "\[Rule]", "0.7`"}], ",", 
     RowBox[{"\"\<Flux\>\"", "\[Rule]", "\"\<Peters\>\""}]}], "]"}], 
   "]"}]}]], "Input"],

