Notebook[{
Cell["pMin", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["pMin",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/pMin"]], "InlineFormula"],
 "\[LineSeparator]",
 "is an option of ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " which stops the integration when p falls to the given value."
}], "Usage"],

Cell["The default, None, does not stop at any p.", "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["SeparatrixBuffer",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/SeparatrixBuffer"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineSeeAlsoFunction"]
}], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell[CellGroupData[{

Cell["Examples Initialization", "ExamplesInitializationSection"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Examples", "PrimaryExamplesSection"],

Cell["Stop at p = 7.5:", "ExampleText"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", 
     RowBox[{"OsculatingInspiral", "[", 
      RowBox[{
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
         RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
          FractionBox["1", 
           SuperscriptBox["10", "3"]]}], ",", 
         RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
         RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
         RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
         RowBox[{"\"\<Force\>\"", "\[Rule]", 
          RowBox[{"ForceModel", "[", 
           RowBox[{"\"\<GasDrag\>\"", ",", 
            RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
             FractionBox["1", 
              SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"pMin", "\[Rule]", "7.5`"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "[", "\"\<StopReason\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{"s", "[", "\"\<p\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"s", "[", "\"\<Domain\>\"", "]"}], "\[LeftDoubleBracket]", "2",
        "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"pMin\"\>", ",", "7.5`"}], "}"}]], "Output"]
}, Open  ]],

Cell["Metadata", "MetadataSection"],

