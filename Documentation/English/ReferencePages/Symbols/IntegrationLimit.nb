Notebook[{
Cell["IntegrationLimit", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineFormula"],
 "\[LineSeparator]",
 "is an option of ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " which gives the largest value of the time variable to integrate to."
}], "Usage"],

Cell[TextData[{
 "The default, Automatic, is 10^7 in coordinate time and 10^4 in Mino time. \
The integration stops earlier at the separatrix buffer or at ",
 Cell[BoxData["pMin"], "InlineFormula"],
 "."
}], "Notes"],

Cell["The earlier functions take it too.", "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["Parametrisation",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/Parametrisation"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["SeparatrixBuffer",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/SeparatrixBuffer"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["pMin",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/pMin"]], 
  "InlineSeeAlsoFunction"]
}], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell[CellGroupData[{

Cell["Examples Initialization", "ExamplesInitializationSection"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Examples", "PrimaryExamplesSection"],

Cell["Integrate to t = 1000:", "ExampleText"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", 
     RowBox[{"OsculatingInspiral", "[", 
      RowBox[{
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
         RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
          FractionBox["1", 
           SuperscriptBox["10", "3"]]}], ",", 
         RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
         RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
         RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
         RowBox[{"\"\<Force\>\"", "\[Rule]", 
          RowBox[{"ForceModel", "[", 
           RowBox[{"\"\<GasDrag\>\"", ",", 
            RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
             FractionBox["1", 
              SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"IntegrationLimit", "\[Rule]", "1000"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "[", "\"\<StopReason\>\"", "]"}], ",", 
     RowBox[{"s", "[", "\"\<Domain\>\"", "]"}]}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"IntegrationLimit\"\>", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1000.`"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

