Notebook[{
Cell["Parametrisation", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Parametrisation",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/Parametrisation"]], 
  "InlineFormula"],
 "\[LineSeparator]",
 "is an option of ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " which gives the time variable: \"CoordinateTime\", the default, or \
\"Mino\"."
}], "Usage"],

Cell["\<\
In Mino time the coordinate time is a property of the inspiral, \
inspiral[\"t\"].\
\>", "Notes"],

Cell["An inspiral with a flux must use coordinate time.", "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineSeeAlsoFunction"]
}], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell[CellGroupData[{

Cell["Examples Initialization", "ExamplesInitializationSection"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Examples", "PrimaryExamplesSection"],

Cell["Integrate to Mino time 5:", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mino", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "3"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
       RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
       RowBox[{"\"\<Force\>\"", "\[Rule]", 
        RowBox[{"ForceModel", "[", 
         RowBox[{"\"\<GasDrag\>\"", ",", 
          RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
           FractionBox["1", 
            SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"Parametrisation", "\[Rule]", "\"\<Mino\>\""}], ",", 
     RowBox[{"IntegrationLimit", "\[Rule]", "5"}]}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"mino", "[", "\"\<Parametrisation\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"mino", "[", "\"\<t\>\"", "]"}], "[", "5", "]"}]}], 
  "}"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Mino\"\>", ",", "427.74982543021105`"}], "}"}]], "Output"]
}, Open  ]],

Cell["Metadata", "MetadataSection"],

Cell[TextData[{
 "New in: ",
