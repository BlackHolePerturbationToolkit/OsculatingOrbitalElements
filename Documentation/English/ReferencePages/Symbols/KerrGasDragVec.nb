Notebook[{
Cell["KerrGasDragVec", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"KerrGasDragVec", "[", 
   RowBox[{
   "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
    ",", " ", "\[Psi]\[Theta]"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "KerrGasDragVec[a,En,L,K, \[Psi]r, \[Psi]\[Theta]] returns vector components \
of a relativistic drag force, {fr,f\[Theta],f\[Phi]}, in terms of a, En, L \
and K."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

