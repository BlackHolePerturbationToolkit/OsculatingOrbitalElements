Notebook[{
Cell["ForceUpDown", "ObjectName"],

Cell[TextData[{
 Cell[BoxData["ForceUpDown"], "InlineFormula"],
 "\[LineSeparator]",
 "ForceUpDown is an option for KerrOsculatingOrbitalElements: \"Down\" (the \
default) when Force gives the covariant components {a_t, a_r, a_\[Theta], a_\
\[Phi]}, \"Up\" when it gives the contravariant {f^r, f^\[Theta], f^\[Phi]}."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

