Cell["The position {t, r, \[Theta], \[Phi]} at t = 1000:", "ExampleText"],

Cell[BoxData[
 RowBox[{"inspiral", "[", "1000", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1000", ",", "8.940586973009356`", ",", "0.7496982331219922`", ",", 
   "47.259463746353575`"}], "}"}]], "Output"],

Cell["The orbital elements at several times:", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"inspiral", "[", "\"\<p\>\"", "]"}], "[", 
  RowBox[{"{", 
   RowBox[{"0", ",", "1000", ",", "2000"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"8.`", ",", "6.243516535693729`", ",", "4.604051024883523`"}], 
  "}"}]], "Output"],

Cell["\<\
The Boyer-Lindquist frequencies of the osculating geodesic, and its action \
angles, which accumulate over the inspiral:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"inspiral", "[", "#1", "]"}], "[", "t", "]"}], "&"}], ")"}], "/@", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\[CapitalOmega]r\>\"", ",", "\"\<\[CapitalOmega]\[Theta]\>\"", 
       ",", "\"\<\[CapitalOmega]\[Phi]\>\""}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "2000"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\[CapitalOmega]r\>\"", ",", "\"\<\[CapitalOmega]\[Theta]\>\"", ",", 
      "\"\<\[CapitalOmega]\[Phi]\>\""}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "None"}], "}"}]}]}], "]"}]], "Input"],

