Notebook[{
Cell["OsculatingInspiralFunction", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["OsculatingInspiralFunction",
    BaseStyle->"Link",
    ButtonData->
     "paclet:OsculatingOrbitalElements/ref/OsculatingInspiralFunction"], "[", 
   "assoc", "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "represents an inspiral computed by ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{"inspiral", "[", "t", "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "gives {t, r, \[Theta], \[Phi]} at time t.",
 "\n",
 Cell[BoxData[
  RowBox[{"inspiral", "[", "\"\<prop\>\"", "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "gives the property \"prop\" of the inspiral."
}], "Usage"],

Cell["\<\
The time is coordinate time, or Mino time if the inspiral was computed with \
Parametrisation -> \"Mino\". Quantities that change along the inspiral are \
functions of it, for example inspiral[\"p\"][t], and they are listable.\
\>", "Notes"],

Cell["The properties include:", "Notes"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<t\>\"", 
      RowBox[{",", " "}], "\"\<r\>\"", 
      RowBox[{",", " "}], "\"\<\[Theta]\>\"", 
      RowBox[{",", " "}], "\"\<\[Phi]\>\""}]], "InlineFormula"], Cell[BoxData[
    ""], "InlineFormula"], Cell["\<\
the Boyer-Lindquist coordinates; \"Trajectory\" gives the four functions\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<p\>\"", 
      RowBox[{",", " "}], "\"\<e\>\"", 
      RowBox[{",", " "}], "\"\<x\>\""}]], "InlineFormula"], Cell[BoxData[
    ""], "InlineFormula"], Cell["\<\
the osculating semi-latus rectum, eccentricity and inclination\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<\[Psi]r\>\"", 
      RowBox[{",", " "}], "\"\<\[Psi]\[Theta]\>\""}]], "InlineFormula"], Cell[
    BoxData[""], "InlineFormula"], Cell["\<\
the Darwin and Hughes phases, in (-\[Pi], \[Pi]]; Missing where undefined (\
\[Psi]r at e = 0, \[Psi]\[Theta] on an equatorial orbit)\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<En\>\"", 
      RowBox[{",", " "}], "\"\<L\>\"", 
      RowBox[{",", " "}], "\"\<Q\>\"", 
      RowBox[{",", " "}], "\"\<K\>\""}]], "InlineFormula"], Cell[BoxData[
    ""], "InlineFormula"], Cell[
    "the osculating constants of motion", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<\[Alpha]p\>\"", 
      RowBox[{",", " "}], "\"\<\[Beta]p\>\""}]], "InlineFormula"], Cell[
    BoxData[""], "InlineFormula"], Cell["\<\
the eccentricity components integrated, e sin \[Psi]r and e cos \[Psi]r\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<\[CapitalOmega]r\>\"", 
      RowBox[{",", " "}], "\"\<\[CapitalOmega]\[Theta]\>\"", 
      RowBox[{",", " "}], "\"\<\[CapitalOmega]\[Phi]\>\""}]], 
     "InlineFormula"], Cell[BoxData[""], "InlineFormula"], Cell[TextData[{
     "the Boyer-Lindquist frequencies of the osculating geodesic, from ",
     Cell[BoxData["KerrGeoFrequencies"], "InlineFormula"]
    }], "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<\[CapitalPhi]r\>\"", 
      RowBox[{",", " "}], "\"\<\[CapitalPhi]\[Theta]\>\"", 
      RowBox[{",", " "}], "\"\<\[CapitalPhi]\[Phi]\>\""}]], "InlineFormula"], 
    Cell[BoxData[""], "InlineFormula"], Cell["\<\
the Boyer-Lindquist action angles of the osculating geodesic, accumulated \
over the inspiral; Missing where undefined (\[CapitalPhi]r at e = 0, \
\[CapitalPhi]\[Theta] on an equatorial orbit)\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<Domain\>\""], "InlineFormula"], Cell[BoxData[""], "InlineFormula"], 
    Cell["{0, end}, the range of the time variable", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<StopReason\>\""], "InlineFormula"], Cell[BoxData[
    ""], "InlineFormula"], Cell["\<\
\"SeparatrixBuffer\", \"pMin\", \"IntegrationLimit\", or \"Other\" if NDSolve \
stopped early\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
     RowBox[{"\"\<Parameters\>\"", 
      RowBox[{",", " "}], "\"\<Force\>\"", 
      RowBox[{",", " "}], "\"\<Flux\>\"", 
      RowBox[{",", " "}], "\"\<Parametrisation\>\""}]], "InlineFormula"], 
    Cell[BoxData[""], "InlineFormula"], Cell["\<\
the parameters, the forces and fluxes as models, and the time variable\
\>", "TableText"]}
  }]], "3ColumnTableMod"],

Cell["\<\
The Boyer-Lindquist action angles advance at the constant rates \
\[CapitalOmega]r, \[CapitalOmega]\[Theta] and \[CapitalOmega]\[Phi] in t \
along a geodesic. They are computed from the osculating elements and phases \
as in P. Lynch and O. Burke, Class. Quantum Grav. 42, 167001 (2025), \
arXiv:2411.04955, and are 0 where \[Psi]r, \[Psi]\[Theta] and \[Phi] are.\
\>", "Notes"],

Cell["inspiral[\"Properties\"] lists all the properties.", "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

