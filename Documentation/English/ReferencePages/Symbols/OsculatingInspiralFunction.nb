  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FluxModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/FluxModel"]], 
  "InlineSeeAlsoFunction"]
}], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell[CellGroupData[{

Cell["Examples Initialization", "ExamplesInitializationSection"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Examples", "PrimaryExamplesSection"],

Cell["Compute an inspiral:", "ExampleText"],

Cell[BoxData[
 RowBox[{"inspiral", "=", 
  RowBox[{"OsculatingInspiral", "[", 
   RowBox[{
    RowBox[{"Association", "[", 
     RowBox[{
      RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
      RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
       FractionBox["1", 
        SuperscriptBox["10", "3"]]}], ",", 
      RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
      RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
      RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
      RowBox[{"\"\<Force\>\"", "\[Rule]", 
       RowBox[{"ForceModel", "[", 
        RowBox[{"\"\<GasDrag\>\"", ",", 
         RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
          FractionBox["1", 
           SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"IntegrationLimit", "\[Rule]", "2000"}]}], "]"}]}]], "Input"],

