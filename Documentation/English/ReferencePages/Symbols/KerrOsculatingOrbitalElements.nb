Notebook[{
Cell["KerrOsculatingOrbitalElements", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"KerrOsculatingOrbitalElements", "[", 
   RowBox[{
   "\[Eta]", ",", " ", "a", ",", " ", "p", ",", " ", "e", ",", " ", "x", ",", 
    " ", "\[Psi]r", ",", " ", "\[Psi]\[Theta]"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "KerrOsculatingOrbitalElements[\[Eta], a, p, e, x, \[Psi]r, \[Psi]\[Theta], \
Force->{at, ar, a\[Theta] a\[Phi]}] calculates En, L, K, \[Psi]r and \[Psi]\
\[Theta] as functions of Mino time (\[Lambda]) or coordinate time(t) using a \
given by covariant components of an acceleration (at, ar, a\[Theta], a\[Phi]) \
a mass ratio given by \[Eta]. The result's \"StopReason\" says why the \
integration stopped: \"Separatrix\", \"SeparatrixBuffer\", \"pMin\", \
\"IntegrationLimit\", or \"Other\" if NDSolve stopped early. Options of \
NDSolve are passed to NDSolve."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[Cell[BoxData[
 ButtonBox["OsculatingInspiral",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], \
"InlineSeeAlsoFunction"]], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell["Metadata", "MetadataSection"],

Cell[TextData[{
 "New in: ",
 Cell["0.1", "HistoryData",
  CellTags->"New"],
 " | Modified in: ",
 Cell[" ", "HistoryData",
  CellTags->"Modified"],
 " | Obsolete in: ",
 Cell[" ", "HistoryData",
  CellTags->"Obsolete"]
}], "History"],

Cell[CellGroupData[{

Cell["Categorization", "CategorizationSection"],

Cell["Symbol", "Categorization",
 CellLabel->"Entity Type"],

Cell["OsculatingOrbitalElements", "Categorization",
 CellLabel->"Paclet Name"],

Cell["OsculatingOrbitalElements`", "Categorization",
 CellLabel->"Context"],

Cell["OsculatingOrbitalElements/ref/KerrOsculatingOrbitalElements", \
"Categorization",
 CellLabel->"URI"]
}, Closed]],

Cell[CellGroupData[{

Cell["Keywords", "KeywordsSection"],

Cell["osculating orbital elements", "Keywords"],

Cell["inspiral", "Keywords"],

Cell["Kerr", "Keywords"]
}, Closed]]
