Cell["Combine forces and fluxes:", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OsculatingInspiral", "[", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
     RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "2"]]}], ",", 
     RowBox[{"\"\<p\>\"", "\[Rule]", "12"}], ",", 
     RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
     RowBox[{"\"\<x\>\"", "\[Rule]", "0.7`"}], ",", 
     RowBox[{"\"\<Flux\>\"", "\[Rule]", "\"\<Peters\>\""}], ",", 
     RowBox[{"\"\<Force\>\"", "\[Rule]", 
      RowBox[{"ForceModel", "[", 
       RowBox[{"\"\<GasDrag\>\"", ",", 
        RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
         FractionBox["1", 
          SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], "]"}], "[", 
  "\"\<Domain\>\"", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "3728.199360007934`"}], "}"}]], "Output"],

Cell["\<\
Schwarzschild is a = 0. Here the first-order self-force fit for Schwarzschild \
drives an equatorial inspiral:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gsf", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "2"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.1`"}], ",", 
       RowBox[{"\"\<x\>\"", "\[Rule]", "1"}], ",", 
       RowBox[{"\"\<Force\>\"", "\[Rule]", "\"\<FastGSF\>\""}]}], "]"}], ",", 
     
     RowBox[{"IntegrationLimit", "\[Rule]", "3000"}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"gsf", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], ",", 
