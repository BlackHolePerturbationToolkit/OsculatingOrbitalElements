Cell["\<\
The semi-latus rectum, eccentricity and inclination relative to their initial \
values. Gas drag shrinks the orbit and, close to the separatrix, makes it \
more eccentric:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "8"], " ", 
      RowBox[{
       RowBox[{"inspiral", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}]}], ",", 
     FractionBox[
      RowBox[{
       RowBox[{"inspiral", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}], "0.3`"], 
     ",", 
     FractionBox[
      RowBox[{
       RowBox[{"inspiral", "[", "\"\<x\>\"", "]"}], "[", "t", "]"}], 
      "0.6`"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{
      RowBox[{"inspiral", "[", "\"\<Domain\>\"", "]"}], 
      "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<p/p0\>\"", ",", "\"\<e/e0\>\"", ",", "\"\<x/x0\>\""}], 
     "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "None"}], "}"}]}]}], "]"}]], "Input"],

