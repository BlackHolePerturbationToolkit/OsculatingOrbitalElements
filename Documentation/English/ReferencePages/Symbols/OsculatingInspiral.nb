Cell[CellGroupData[{

Cell["More Examples", "ExtendedExamplesSection"],

Cell[CellGroupData[{

Cell["Scope", "ExampleSection"],

Cell["\<\
Drive an inspiral with a flux, here the leading-order gravitational-wave flux:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"peters", "=", 
  RowBox[{"OsculatingInspiral", "[", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
     RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "2"]]}], ",", 
     RowBox[{"\"\<p\>\"", "\[Rule]", "12"}], ",", 
     RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
     RowBox[{"\"\<x\>\"", "\[Rule]", "0.7`"}], ",", 
     RowBox[{"\"\<Flux\>\"", "\[Rule]", "\"\<Peters\>\""}]}], "]"}], 
   "]"}]}]], "Input"],

