Cell["\<\
The trajectory in Boyer-Lindquist coordinates, as Cartesian-like coordinates:\
\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"inspiral", "[", "\"\<r\>\"", "]"}], "[", "t", "]"}]}], ",", 
       
       RowBox[{"\[Theta]", "=", 
        RowBox[{
         RowBox[{"inspiral", "[", "\"\<\[Theta]\>\"", "]"}], "[", "t", 
         "]"}]}], ",", 
       RowBox[{"\[Phi]", "=", 
        RowBox[{
         RowBox[{"inspiral", "[", "\"\<\[Phi]\>\"", "]"}], "[", "t", 
         "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
       RowBox[{"r", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
       RowBox[{"r", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{
      RowBox[{"inspiral", "[", "\"\<Domain\>\"", "]"}], 
      "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "}"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "3000"}], ",", 
   RowBox[{"MaxRecursion", "\[Rule]", "0"}], ",", 
   RowBox[{"BoxRatios", "\[Rule]", "Automatic"}]}], "]"}]], "Input"],

