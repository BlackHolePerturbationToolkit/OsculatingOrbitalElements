        "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"pMin\"\>", ",", "7.5`"}], "}"}]], "Output"],

Cell["Options of NDSolve are passed to NDSolve:", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OsculatingInspiral", "[", 
   RowBox[{
    RowBox[{"Association", "[", 
     RowBox[{
      RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
      RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
       FractionBox["1", 
        SuperscriptBox["10", "3"]]}], ",", 
      RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
      RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
      RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
      RowBox[{"\"\<Force\>\"", "\[Rule]", 
       RowBox[{"ForceModel", "[", 
        RowBox[{"\"\<GasDrag\>\"", ",", 
         RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
          FractionBox["1", 
           SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"MaxSteps", "\[Rule]", "50"}]}], "]"}], "[", "\"\<StopReason\>\"",
   "]"}]], "Input"],

Cell["\<\
NDSolve::mxst: Maximum number of 50 steps reached at the point \
OsculatingOrbitalElements`Private`t$468016 == 143.901.\
\>", "Message", "MSG"],

Cell["\<\
OsculatingInspiral::early: Warning: NDSolve stopped at t = 143.901, before \
reaching IntegrationLimit or a stopping condition.\
\>", "Message", "MSG"],

Cell[BoxData["\<\"Other\"\>"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Properties & Relations", "ExampleSection"],

Cell["\<\
With no force or flux the orbit is a geodesic, and its constants of motion \
are those of KerrGeodesics:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"geodesic", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "3"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
       RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
       RowBox[{"\"\<Force\>\"", "\[Rule]", "None"}]}], "]"}], ",", 
     RowBox[{"IntegrationLimit", "\[Rule]", "1000"}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"geodesic", "[", "\"\<En\>\"", "]"}], "[", "500", "]"}], ",", 
    RowBox[{
     RowBox[{"geodesic", "[", "\"\<L\>\"", "]"}], "[", "500", "]"}], ",", 
    RowBox[{
     RowBox[{"geodesic", "[", "\"\<Q\>\"", "]"}], "[", "500", "]"}]}], "}"}], 
  "-", 
  RowBox[{"Values", "[", 
   RowBox[{"KerrGeoConstantsOfMotion", "[", 
    RowBox[{"0.9`", ",", "8", ",", "0.3`", ",", "0.6`"}], "]"}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2.101629315021114`*^-9"}], ",", 
   RowBox[{"-", "4.895433614038325`*^-9"}], ",", 
   RowBox[{"-", "3.236234924486325`*^-8"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Possible Issues", "ExampleSection"],

Cell["Orbits that start exactly polar are not supported:", "ExampleText"],

Cell[BoxData[
 RowBox[{"OsculatingInspiral", "[", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
    RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}], ",", 
    RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
    RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
    RowBox[{"\"\<x\>\"", "\[Rule]", "0"}], ",", 
    RowBox[{"\"\<Force\>\"", "\[Rule]", "None"}]}], "]"}], "]"}]], "Input"],

Cell["\<\
OsculatingInspiral::polar: Orbits that start exactly polar (x = 0) are not \
supported, since they pass through the poles, where Boyer-Lindquist \
coordinates are singular.\
\>", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["\<\
An equatorial orbit stays in the plane, so a force with a \[Theta] component \
there is rejected:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"OsculatingInspiral", "[", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<a\>\"", "\[Rule]", "0.5`"}], ",", 
    RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
     FractionBox["1", 
      SuperscriptBox["10", "4"]]}], ",", 
    RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
    RowBox[{"\"\<e\>\"", "\[Rule]", "0.2`"}], ",", 
    RowBox[{"\"\<x\>\"", "\[Rule]", "1"}], ",", 
    RowBox[{"\"\<Force\>\"", "\[Rule]", 
     RowBox[{"ForceModel", "[", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "a", ",", "p", ",", "e", ",", "x", ",", "\[Psi]r", ",", 
          "\[Psi]\[Theta]", ",", "\[Phi]", ",", "t"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "]"}], "]"}]}]}], "]"}], 
  "]"}]], "Input"],

Cell["\<\
OsculatingInspiral::eqforce: The force has a nonzero \\[Theta] component, \
1/10000, in the equatorial plane, so the orbit would leave the plane. \
Equatorial orbits (x = +-1) are integrated with x held fixed, so they need a \
force with no \\[Theta] component in the plane.\
\>", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["The initial orbit must lie outside the separatrix:", "ExampleText"],

Cell[BoxData[
 RowBox[{"OsculatingInspiral", "[", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
    RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}], ",", 
    RowBox[{"\"\<p\>\"", "\[Rule]", "3"}], ",", 
    RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
    RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
    RowBox[{"\"\<Force\>\"", "\[Rule]", "None"}]}], "]"}], "]"}]], "Input"],

Cell["\<\
OsculatingInspiral::sep: The initial orbit must lie outside the separatrix by \
more than the separatrix buffer, 1/1000: p = 3, and the separatrix is at p = \
3.74456.\
\>", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["\<\
Fluxes are averages with respect to coordinate time, so they cannot be used \
in Mino time:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"OsculatingInspiral", "[", 
  RowBox[{
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
     RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "2"]]}], ",", 
     RowBox[{"\"\<p\>\"", "\[Rule]", "12"}], ",", 
     RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
     RowBox[{"\"\<x\>\"", "\[Rule]", "0.7`"}], ",", 
     RowBox[{"\"\<Flux\>\"", "\[Rule]", "\"\<Peters\>\""}]}], "]"}], ",", 
   RowBox[{"Parametrisation", "\[Rule]", "\"\<Mino\>\""}]}], "]"}]], "Input"],

Cell["\<\
OsculatingInspiral::fluxtime: Fluxes are averages with respect to coordinate \
time, so an inspiral with a flux needs Parametrisation -> \"CoordinateTime\".\
\
\>", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"]
}, Open  ]]
}, Open  ]],

