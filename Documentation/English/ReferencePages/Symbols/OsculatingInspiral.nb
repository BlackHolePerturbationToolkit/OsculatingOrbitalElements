(* Beginning of Notebook Content *)
Notebook[{
Cell["OsculatingInspiral", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["OsculatingInspiral",
    BaseStyle->"Link",
    ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"], 
   "[", "params", "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "integrates the osculating geodesic equations for an inspiral in Kerr \
spacetime, driven by the forces and fluxes in ",
 Cell[BoxData["params"], "InlineFormula"],
 ", and returns an ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiralFunction",
   BaseStyle->"Link",
   ButtonData->
    "paclet:OsculatingOrbitalElements/ref/OsculatingInspiralFunction"]], 
  "InlineFormula"],
 "."
}], "Usage"],

Cell[TextData[{
 "The parameters ",
 Cell[BoxData["params"], "InlineFormula"],
 " are an Association with these keys:"
}], "Notes"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo"], Cell[BoxData["\"\<a\>\""], "InlineFormula"], 
    Cell[BoxData[""], "InlineFormula"], Cell["\<\
the spin of the black hole, 0 \[LessEqual] a < 1; a = 0 is Schwarzschild\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<\[Epsilon]\>\""], "InlineFormula"], Cell[BoxData[
    ""], "InlineFormula"], Cell["\<\
the small mass ratio, which multiplies the forces and fluxes that scale with \
it\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData["\"\<p\>\""], "InlineFormula"], 
    Cell[BoxData[""], "InlineFormula"], Cell[
    "the initial semi-latus rectum", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData["\"\<e\>\""], "InlineFormula"], 
    Cell[BoxData[""], "InlineFormula"], Cell[
    "the initial eccentricity, 0 \[LessEqual] e < 1", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData["\"\<x\>\""], "InlineFormula"], 
    Cell[BoxData[""], "InlineFormula"], Cell["\<\
the initial inclination x = cos \[Iota], with x \[NotEqual] 0; x = \
\[PlusMinus]1 is an equatorial orbit\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<Force\>\""], "InlineFormula"], Cell[BoxData[
    "None"], "InlineFormula"], Cell[TextData[{
     "a ",
     Cell[BoxData[
      ButtonBox["ForceModel",
       BaseStyle->"Link",
       ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
      "InlineFormula"],
     ", the name of a built-in force, a list of these, or None"
    }], "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData["\"\<Flux\>\""], "InlineFormula"],
     Cell[BoxData["None"], "InlineFormula"], Cell[TextData[{
     "a ",
     Cell[BoxData[
      ButtonBox["FluxModel",
       BaseStyle->"Link",
       ButtonData->"paclet:OsculatingOrbitalElements/ref/FluxModel"]], 
      "InlineFormula"],
     ", the name of a built-in flux, a list of these, or None"
    }], "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<\[Psi]r\>\""], "InlineFormula"], Cell[BoxData["0"], "InlineFormula"],
     Cell["the initial Darwin (radial) phase", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<\[Psi]\[Theta]\>\""], "InlineFormula"], Cell[BoxData[
    "0"], "InlineFormula"], Cell[
    "the initial Hughes (polar) phase", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<\[Phi]\>\""], "InlineFormula"], Cell[BoxData["0"], "InlineFormula"], 
    Cell["the initial azimuth", "TableText"]}
  }]], "3ColumnTableMod"],

Cell["\<\
At least one of \"Force\" and \"Flux\" must be given. With neither force nor \
flux the orbit is a geodesic.\
\>", "Notes"],

Cell["\<\
Forces enter through the osculating geodesic equations. A flux changes only \
the slowly varying elements p, e and x, at its orbit-averaged rate with \
respect to coordinate time, and the phases advance at their geodesic rates. \
Forces and fluxes can be combined, and several of each add.\
\>", "Notes"],

Cell["\<\
The equations integrate p, the eccentricity components e sin \[Psi]r and e \
cos \[Psi]r, which are regular for circular orbits, x, the polar phase \[Psi]\
\[Theta], and \[Phi]. An inspiral can pass through x = 0 from prograde to \
retrograde. Orbits that start exactly polar, x = 0, are not supported.\
\>", "Notes"],

Cell["\<\
Equatorial orbits, x = \[PlusMinus]1, are a special case: x stays \
\[PlusMinus]1 and \[Theta] = \[Pi]/2, so the force must have no \[Theta] \
component in the equatorial plane, and a flux must not change x. Close to the \
equator, a force with a \[Theta] component makes the equations stiff.\
\>", "Notes"],

Cell[TextData[{
 "The integration stops at p = p_sep + \[Epsilon] outside the separatrix, at ",
 Cell[BoxData[
  ButtonBox["pMin",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/pMin"]], "InlineFormula"],
 ", or at ",
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineFormula"],
 ". The result's \"StopReason\" says which; only an early stop by NDSolve \
gives a message."
}], "Notes"],

Cell["The following options can be given:", "Notes"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "Parametrisation"], "InlineFormula"], Cell[BoxData[
    "\"\<CoordinateTime\>\""], "InlineFormula"], Cell["\<\
the time variable: coordinate time t, or \"Mino\" for Mino time \[Lambda]\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "IntegrationLimit"], "InlineFormula"], Cell[BoxData[
    "Automatic"], "InlineFormula"], Cell["\<\
the largest value of the time variable: Automatic is 10^7 in coordinate time \
and 10^4 in Mino time\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "SeparatrixBuffer"], "InlineFormula"], Cell[BoxData[
    "Automatic"], "InlineFormula"], Cell["\<\
how far outside the separatrix, in p, to stop: Automatic is \[Epsilon]\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData["pMin"], "InlineFormula"], Cell[
    BoxData["None"], "InlineFormula"], Cell[
    "a value of p at which to stop", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData["TimeMonitor"], "InlineFormula"], 
    Cell[BoxData["False"], "InlineFormula"], Cell["\<\
whether to show the progress of the integration in a notebook\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData["AccuracyGoal"], "InlineFormula"],
     Cell[BoxData["12"], "InlineFormula"], Cell[
    "passed to NDSolve", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "PrecisionGoal"], "InlineFormula"], Cell[BoxData["12"], "InlineFormula"], 
    Cell["passed to NDSolve", "TableText"]}
  }]], "3ColumnTableMod"],

Cell["\<\
Any option of NDSolve can also be given, and is passed to NDSolve. By default \
NDSolve uses an 8th-order explicit Runge-Kutta method, which resolves the \
rapid swings of \[Phi] as a near-polar orbit passes close to the poles; \
looser goals, or another Method, may not.\
\>", "Notes"],

Cell["\<\
Values between the integration steps are interpolated, by default to lower \
order than the integration. InterpolationOrder -> All makes them as accurate \
as the integration, at about ten times the memory.\
\>", "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiralFunction",
   BaseStyle->"Link",
   ButtonData->
    "paclet:OsculatingOrbitalElements/ref/OsculatingInspiralFunction"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FluxModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/FluxModel"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["SeparatrixBuffer",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/SeparatrixBuffer"]], 
  "InlineSeeAlsoFunction"]
}], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell[CellGroupData[{

Cell["Examples Initialization", "ExamplesInitializationSection"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Examples", "PrimaryExamplesSection"],

Cell["\<\
An inspiral driven by gas drag, around a black hole with spin a = 0.9:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"inspiral", "=", 
  RowBox[{"OsculatingInspiral", "[", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
     RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "3"]]}], ",", 
     RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
     RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
     RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
     RowBox[{"\"\<Force\>\"", "\[Rule]", 
      RowBox[{"ForceModel", "[", 
       RowBox[{"\"\<GasDrag\>\"", ",", 
        RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
         FractionBox["1", 
          SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], "]"}]}]], "Input"],

