Cell["\<\
Integrate in Mino time instead of coordinate time. Then the coordinate time \
is a property:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mino", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "3"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
       RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
       RowBox[{"\"\<Force\>\"", "\[Rule]", 
        RowBox[{"ForceModel", "[", 
         RowBox[{"\"\<GasDrag\>\"", ",", 
          RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
           FractionBox["1", 
            SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"Parametrisation", "\[Rule]", "\"\<Mino\>\""}], ",", 
     RowBox[{"IntegrationLimit", "\[Rule]", "10"}]}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"mino", "[", "\"\<Domain\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"mino", "[", "\"\<t\>\"", "]"}], "[", "10", "]"}]}], 
  "}"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "10.`"}], "}"}], ",", "748.8043206250096`"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "ExampleSection"],

Cell[TextData[{
 "Stop further from the separatrix with ",
 Cell[BoxData[
  ButtonBox["SeparatrixBuffer",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/SeparatrixBuffer"]], 
  "InlineFormula"],
 ":"
}], "ExampleText"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", 
     RowBox[{"OsculatingInspiral", "[", 
      RowBox[{
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
         RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
          FractionBox["1", 
           SuperscriptBox["10", "3"]]}], ",", 
         RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
         RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
         RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
         RowBox[{"\"\<Force\>\"", "\[Rule]", 
          RowBox[{"ForceModel", "[", 
           RowBox[{"\"\<GasDrag\>\"", ",", 
            RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
             FractionBox["1", 
              SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"SeparatrixBuffer", "\[Rule]", "0.5`"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "[", "\"\<StopReason\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{"s", "[", "\"\<p\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"s", "[", "\"\<Domain\>\"", "]"}], "\[LeftDoubleBracket]", "2",
        "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"SeparatrixBuffer\"\>", ",", "4.337387716250146`"}], 
  "}"}]], "Output"],

Cell[TextData[{
 "Stop at a given p with ",
 Cell[BoxData[
  ButtonBox["pMin",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/pMin"]], "InlineFormula"],
 ":"
}], "ExampleText"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", 
