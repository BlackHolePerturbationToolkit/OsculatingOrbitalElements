Notebook[{
Cell["KerrEMCons", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"KerrEMCons", "[", 
   RowBox[{
   "a", ",", " ", "p", ",", " ", "e", ",", " ", "x", ",", " ", "\[Psi]r", ",",
     " ", "\[Psi]\[Theta]"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "KerrEMCons[a,p,e,x, \[Psi]r, \[Psi]\[Theta]] returns covarient components \
of a relativistic electromagnetic force, {at,ar,a\[Theta],a\[Phi]}, in terms \
of a, p, e and x."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[Cell[BoxData[
 ButtonBox["ForceModel",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OsculatingOrbitalElements/ref/ForceModel"]], \
"InlineSeeAlsoFunction"]], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell["Metadata", "MetadataSection"],

