Notebook[{
Cell["KerrGasDrag", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"KerrGasDrag", "[", 
   RowBox[{
   "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
    ",", " ", "\[Psi]\[Theta]"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "KerrGasDrag[a,En,L,K, \[Psi]r, \[Psi]\[Theta]] returns covarient components \
of a relativistic drag force, {at,ar,a\[Theta],a\[Phi]}, in terms of a, En, L \
and K."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

