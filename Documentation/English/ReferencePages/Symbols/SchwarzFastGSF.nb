Notebook[{
Cell["SchwarzFastGSF", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SchwarzFastGSF", "[", 
   RowBox[{"p", ",", " ", "e", ",", " ", "\[Xi]"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "SchwarzFastGSF[p,e,\[Xi]] returns Fr and F\[Phi] in terms of p, e, and \
\[Xi]. \nThis function is accurate to first order for p < 12 and e< 0.2"
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

