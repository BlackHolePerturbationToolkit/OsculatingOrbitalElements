Notebook[{
Cell["SchwarzGasDrag", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SchwarzGasDrag", "[", 
   RowBox[{"p", ",", " ", "e", ",", " ", "\[Xi]"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "SchwarzGasDrag[p,e,\[Xi]] returns contravarient components of a \
relativistic drag force, {Fr F\[Phi]}, in terms of p, e, and \[Xi]."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

