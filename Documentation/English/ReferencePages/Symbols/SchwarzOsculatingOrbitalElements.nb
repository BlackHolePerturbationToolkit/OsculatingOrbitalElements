Notebook[{
Cell["SchwarzOsculatingOrbitalElements", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SchwarzOsculatingOrbitalElements", "[", 
   RowBox[{"\[Eta]", ",", " ", "p", ",", " ", "e", ",", " ", "\[Xi]"}], 
   "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "SchwarzOsculatingOrbitalElements[\[Eta], p, e, \[Xi], Force-> {Fr, \
F\[Phi]}] calculates p, e, \[Xi], t and \[Phi] as functions of the Darwin \
Parameter (\[Chi]) using the contravarient components of an acceleration \
(Fr,F\[Phi]) and a mass ratio given by \[Eta]. The result's \"StopReason\" \
says why the integration stopped: \"Separatrix\", \"SeparatrixBuffer\", \
\"pMin\", \"IntegrationLimit\", or \"Other\" if NDSolve stopped early. \
Options of NDSolve are passed to NDSolve."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[Cell[BoxData[
 ButtonBox["OsculatingInspiral",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], \
"InlineSeeAlsoFunction"]], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell["Metadata", "MetadataSection"],

Cell[TextData[{
