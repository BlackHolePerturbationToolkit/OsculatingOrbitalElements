Notebook[{
Cell["SeparatrixBuffer", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SeparatrixBuffer",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/SeparatrixBuffer"]], 
  "InlineFormula"],
 "\[LineSeparator]",
 "is an option of ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " which gives how far outside the separatrix, in p, the integration stops."
}], "Usage"],

Cell["The default, Automatic, is the mass ratio \[Epsilon].", "Notes"],

Cell["\<\
The initial orbit must lie further than this outside the separatrix.\
\>", "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["pMin",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/pMin"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineSeeAlsoFunction"]
}], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell[CellGroupData[{

Cell["Examples Initialization", "ExamplesInitializationSection"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Examples", "PrimaryExamplesSection"],

Cell["Stop 0.5 outside the separatrix:", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "3"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "8"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
       RowBox[{"\"\<x\>\"", "\[Rule]", "0.6`"}], ",", 
       RowBox[{"\"\<Force\>\"", "\[Rule]", 
        RowBox[{"ForceModel", "[", 
         RowBox[{"\"\<GasDrag\>\"", ",", 
          RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
           FractionBox["1", 
            SuperscriptBox["10", "4"]]}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"SeparatrixBuffer", "\[Rule]", "0.5`"}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"end", "=", 
     RowBox[{
      RowBox[{"s", "[", "\"\<Domain\>\"", "]"}], "\[LeftDoubleBracket]", "2", 
      "\[RightDoubleBracket]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"s", "[", "\"\<p\>\"", "]"}], "[", "end", "]"}], "-", 
    RowBox[{"KerrGeoSeparatrix", "[", 
     RowBox[{"0.9`", ",", 
      RowBox[{
       RowBox[{"s", "[", "\"\<e\>\"", "]"}], "[", "end", "]"}], ",", 
      RowBox[{
       RowBox[{"s", "[", "\"\<x\>\"", "]"}], "[", "end", "]"}]}], "]"}]}]}], 
  "]"}]], "Input"],

Cell[BoxData["0.49999999999973266`"], "Output"]
}, Open  ]],

Cell["Metadata", "MetadataSection"],

Cell[TextData[{
