Cell["\<\
A force with a parameter, which f receives as its last argument:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"weak", "=", 
   RowBox[{"ForceModel", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", "p", ",", "e", ",", "x", ",", "\[Psi]r", ",", 
         "\[Psi]\[Theta]", ",", "\[Phi]", ",", "t", ",", "par"}], "}"}], ",", 
       
       RowBox[{
        RowBox[{"par", "[", "\"\<k\>\"", "]"}], " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "\[Rule]", 
      RowBox[{"Association", "[", 
       RowBox[{"\"\<k\>\"", "\[Rule]", "1"}], "]"}]}], ",", 
     RowBox[{"\"\<Name\>\"", "\[Rule]", "\"\<Torque\>\""}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ForceModel", "[", 
   RowBox[{"weak", ",", 
    RowBox[{"\"\<k\>\"", "\[Rule]", "2"}]}], "]"}], "[", 
  RowBox[{
  "0.9`", ",", "8", ",", "0.3`", ",", "0.6`", ",", "0.5`", ",", "1.`", ",", 
   "0", ",", "0"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.10075982310924649`", ",", "0", ",", "0", ",", 
   RowBox[{"-", "2"}]}], "}"}]], "Output"],

Cell["\<\
A force that is not axisymmetric depends on \[Phi]. This one is a uniform \
field in the equatorial plane, the gradient of r sin \[Theta] cos \[Phi]:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"field", "=", 
   RowBox[{"ForceModel", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", "p", ",", "e", ",", "x", ",", "\[Psi]r", ",", 
         "\[Psi]\[Theta]", ",", "\[Phi]", ",", "t"}], "}"}], ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", "=", 
            FractionBox["p", 
             RowBox[{"1", "+", 
              RowBox[{"e", " ", 
               RowBox[{"Cos", "[", "\[Psi]r", "]"}]}]}]]}], ",", 
           RowBox[{"c", "=", 
            RowBox[{
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["x", "2"]}]], " ", 
             RowBox[{"Cos", "[", "\[Psi]\[Theta]", "]"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["c", "2"]}]], " ", 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
           RowBox[{"r", " ", "c", " ", 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
           RowBox[{
            RowBox[{"-", "r"}], " ", 
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["c", "2"]}]], " ", 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "}"}]}], "]"}]}], "]"}], 
     ",", 
     RowBox[{"\"\<Name\>\"", "\[Rule]", "\"\<Uniform field\>\""}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "5"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.2`"}], ",", 
