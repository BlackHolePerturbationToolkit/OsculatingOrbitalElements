Cell["More Examples", "ExtendedExamplesSection"],

Cell[CellGroupData[{

Cell["Scope", "ExampleSection"],

Cell["\<\
A custom force: a torque, which reduces the angular momentum, and so x:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{
  RowBox[{"torque", "=", 
   RowBox[{"ForceModel", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", "p", ",", "e", ",", "x", ",", "\[Psi]r", ",", 
         "\[Psi]\[Theta]", ",", "\[Phi]", ",", "t"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"\"\<Name\>\"", "\[Rule]", "\"\<Torque\>\""}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tilted", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0.5`"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "4"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.2`"}], ",", 
       RowBox[{"\"\<x\>\"", "\[Rule]", "0.8`"}], ",", 
       RowBox[{"\"\<Force\>\"", "\[Rule]", "torque"}]}], "]"}], ",", 
     RowBox[{"IntegrationLimit", "\[Rule]", "3000"}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
