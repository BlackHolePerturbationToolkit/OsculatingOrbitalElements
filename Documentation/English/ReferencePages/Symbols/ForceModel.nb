(* Beginning of Notebook Content *)
Notebook[{
Cell["ForceModel", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["ForceModel",
    BaseStyle->"Link",
    ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"], "[", "f", 
   "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "is a force for ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 ", where f[a, p, e, x, \[Psi]r, \[Psi]\[Theta], \[Phi], t] gives the \
covariant components {F_r, F_\[Theta], F_\[Phi]}.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ForceModel",
    BaseStyle->"Link",
    ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"], "[", 
   RowBox[{"\"\<name\>\"", ",", 
    RowBox[{"param", "\[Rule]", "value"}], ",", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula"],
 "\[LineSeparator]",
 "is a built-in force model.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ForceModel",
    BaseStyle->"Link",
    ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"], "[", 
   RowBox[{"model", ",", 
    RowBox[{"param", "\[Rule]", "value"}], ",", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula"],
 "\[LineSeparator]",
 "changes the parameters of a model.",
 "\n",
 Cell[BoxData[
  RowBox[{"model", "[", 
   RowBox[{
   "a", ",", "p", ",", "e", ",", "x", ",", "\[Psi]r", ",", "\[Psi]\[Theta]", 
    ",", "\[Phi]", ",", "t"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "gives the covariant force {F_t, F_r, F_\[Theta], F_\[Phi]}."
}], "Usage"],

Cell["\<\
f gets the elements and phases of the osculating geodesic, the azimuth \[Phi] \
and the coordinate time t, as numbers. \[Phi] and t allow forces that are not \
axisymmetric or stationary, such as the tidal field of a third body.\
\>", "Notes"],

Cell[TextData[{
 "An undefined phase is passed as 0: \[Psi]r at e = 0, and \[Psi]\[Theta] on \
an equatorial orbit, where a physical force does not depend on it. On an \
equatorial orbit, x = \[PlusMinus]1, ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " keeps the orbit in the plane, so the force must have no \[Theta] component \
there."
}], "Notes"],

Cell["F_t follows from orthogonality to the velocity, u^\[Mu] F_\[Mu] = 0.", \
"Notes"],

Cell["\<\
A model with parameters also gets them, as an Association: f[a, p, e, x, \
\[Psi]r, \[Psi]\[Theta], \[Phi], t, params]. The force is multiplied by the \
mass ratio \[Epsilon] unless \"ScalesWithMassRatio\" is False.\
\>", "Notes"],

Cell["The following options can be given:", "Notes"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo"], Cell[BoxData["\"\<Name\>\""], "InlineFormula"],
     Cell[BoxData["\"\<Custom\>\""], "InlineFormula"], Cell[
    "the model's name", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<Parameters\>\""], "InlineFormula"], Cell[BoxData[
     RowBox[{"Association", "[", "]"}]], "InlineFormula"], Cell["\<\
the parameter values; Missing[\"Required\"] marks one that must be set\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<ScalesWithMassRatio\>\""], "InlineFormula"], Cell[BoxData[
    "True"], "InlineFormula"], Cell[
    "whether the force is multiplied by \[Epsilon]", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<ValidityCondition\>\""], "InlineFormula"], Cell[BoxData[
     RowBox[{"True", "&"}]], "InlineFormula"], Cell["\<\
a function of (a, p, e, x) that is True where the model is valid; outside, a \
warning is given\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<ValidityDescription\>\""], "InlineFormula"], Cell[BoxData[
    "None"], "InlineFormula"], Cell[
    "the range of validity in words", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<Description\>\""], "InlineFormula"], Cell[BoxData[
    "None"], "InlineFormula"], Cell["a description", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<Citation\>\""], "InlineFormula"], Cell[BoxData[
    "None"], "InlineFormula"], Cell[
    "the reference for the model", "TableText"]}
  }]], "3ColumnTableMod"],

Cell["The built-in models are:", "Notes"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<GasDrag\>\""], "InlineFormula"], Cell[BoxData[
     RowBox[{"\"\<Coefficient\>\"", "\[Rule]", "k"}]], "InlineFormula"], 
    Cell["\<\
relativistic gas drag, -k (u_\[Mu] + \[Delta]^t_\[Mu]/u^t); does not scale \
with \[Epsilon]\
\>", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<EMConservative\>\""], "InlineFormula"], Cell[BoxData[
    ""], "InlineFormula"], Cell[
    "a conservative electromagnetic force", "TableText"]},
   {Cell["      ", "ModInfo"], Cell[BoxData[
    "\"\<FastGSF\>\""], "InlineFormula"], Cell[BoxData[""], "InlineFormula"], 
    Cell["\<\
a fit to the first-order gravitational self-force in Schwarzschild, valid for \
a = 0, p \[LessEqual] 12 and e \[LessEqual] 0.2\
\>", "TableText"]}
  }]], "3ColumnTableMod"],

Cell["\<\
model[\"prop\"] gives a property, and model[\"Properties\"] lists them.\
\>", "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineSeeAlsoFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FluxModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/FluxModel"]], 
  "InlineSeeAlsoFunction"]
}], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell[CellGroupData[{

Cell["Examples Initialization", "ExamplesInitializationSection"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<OsculatingOrbitalElements`\>\"", 
  "]"}]], "ExampleInitialization"]
}, Open  ]],

