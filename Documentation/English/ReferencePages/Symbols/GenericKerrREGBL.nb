Notebook[{
Cell["GenericKerrREGBL", "ObjectName"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"GenericKerrREGBL", "[", 
   RowBox[{
   "\[Eta]", ",", " ", "a", ",", " ", "p", ",", " ", "e", ",", " ", "x", ",", 
    " ", "\[Psi]r", ",", " ", "\[Psi]\[Theta]"}], "]"}]], "InlineFormula"],
 "\[LineSeparator]",
 "GenericKerrREGBL[\[Eta], a, p, e, x, \[Psi]r, \[Psi]\[Theta], opts] uses \
the exact regular eccentricity-component equations with the same arguments \
and options as GenericKerrpexBL. It also returns \"\[Alpha]p\"=e Sin[\[Psi]r] \
and \"\[Beta]p\"=e Cos[\[Psi]r]. The returned \"\[Psi]r\" is a \
principal-value phase and is Missing at e=0; its initial argument is ignored \
when e0=0. Custom covariant force callbacks retain the pex arguments and must \
be independent of the radial phase at e=0 (where the callback receives zero). \
Equatorial orbits (x = \[PlusMinus]1), the result's \"StopReason\" and \
NDSolve options are handled as in GenericKerrpexBL."
}], "Usage"],

Cell[TextData[{
 "Legacy: this is one of the earlier functions of the package. It keeps \
working, but ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 " supersedes it."
}], "Notes"],

Cell["Tech Notes", "TechNotesSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/tutorial/OsculatingOrbitalElements"]], \
"Tutorials"],

Cell["See Also", "SeeAlsoSection"],

Cell[TextData[Cell[BoxData[
 ButtonBox["OsculatingInspiral",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], \
"InlineSeeAlsoFunction"]], "SeeAlso"],

Cell["Related Guides", "MoreAboutSection"],

Cell[TextData[ButtonBox["Osculating Orbital Elements",
 BaseStyle->"Link",
 ButtonData->
  "paclet:OsculatingOrbitalElements/guide/OsculatingOrbitalElements"]], \
"MoreAbout"],

Cell["Metadata", "MetadataSection"],

Cell[TextData[{
 "New in: ",
 Cell["0.1", "HistoryData",
  CellTags->"New"],
 " | Modified in: ",
 Cell[" ", "HistoryData",
  CellTags->"Modified"],
 " | Obsolete in: ",
 Cell[" ", "HistoryData",
  CellTags->"Obsolete"]
}], "History"],

Cell[CellGroupData[{

Cell["Categorization", "CategorizationSection"],

Cell["Symbol", "Categorization",
 CellLabel->"Entity Type"],

Cell["OsculatingOrbitalElements", "Categorization",
 CellLabel->"Paclet Name"],

Cell["OsculatingOrbitalElements`", "Categorization",
 CellLabel->"Context"],

Cell["OsculatingOrbitalElements/ref/GenericKerrREGBL", "Categorization",
 CellLabel->"URI"]
}, Closed]],

Cell[CellGroupData[{

Cell["Keywords", "KeywordsSection"],

Cell["osculating orbital elements", "Keywords"],

Cell["inspiral", "Keywords"],

Cell["Kerr", "Keywords"]
}, Closed]]
},
