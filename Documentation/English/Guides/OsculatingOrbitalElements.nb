Notebook[{
Cell["Osculating Orbital Elements", "GuideTitle"],

Cell["\<\
The OsculatingOrbitalElements package computes inspirals in Kerr spacetime \
with the method of osculating geodesics. An inspiral is driven by forces, \
which act through the osculating geodesic equations, by fluxes, which are \
orbit-averaged rates of change of the orbital elements, or by both. Its \
equations are regular for circular orbits and as an orbit passes from \
prograde to retrograde, and equatorial orbits are a special case.\
\>", "GuideAbstract"],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineGuideFunction"],
 " \[LongDash] ",
 "integrate an inspiral, from an Association of parameters"
}], "GuideText"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OsculatingInspiralFunction",
   BaseStyle->"Link",
   ButtonData->
    "paclet:OsculatingOrbitalElements/ref/OsculatingInspiralFunction"]], 
  "InlineGuideFunction"],
 " \[LongDash] ",
 "the inspiral: its trajectory, orbital elements, phases and constants of \
motion"
}], "GuideText"],

Cell["\t", "GuideDelimiter"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineGuideFunction"],
 " \[LongDash] ",
 "a force: custom, or a built-in model (\"GasDrag\", \"EMConservative\", \
\"FastGSF\")"
}], "GuideText"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["FluxModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/FluxModel"]], 
  "InlineGuideFunction"],
 " \[LongDash] ",
 "a flux: custom, a built-in model (\"Peters\"), or the orbit average of a \
force"
}], "GuideText"],

Cell["\t", "GuideDelimiter"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Parametrisation",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/Parametrisation"]], 
  "InlineGuideFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineGuideFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["SeparatrixBuffer",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/SeparatrixBuffer"]], 
  "InlineGuideFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
