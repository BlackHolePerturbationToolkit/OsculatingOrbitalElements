  "InlineGuideFunction"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["TimeMonitor",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/TimeMonitor"]], 
  "InlineGuideFunction"]
}], "InlineGuideFunctionListing"],

