Cell["Options", "Subsection"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["IntegrationLimit",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/IntegrationLimit"]], 
  "InlineFormula"],
 ", ",
 Cell[BoxData[
  ButtonBox["SeparatrixBuffer",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/SeparatrixBuffer"]], 
  "InlineFormula"],
 " and ",
 Cell[BoxData[
  ButtonBox["pMin",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/pMin"]], "InlineFormula"],
 " control where the integration stops, ",
 Cell[BoxData[
  ButtonBox["Parametrisation",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/Parametrisation"]], 
  "InlineFormula"],
 " -> \"Mino\" integrates in Mino time, and any option of NDSolve is passed \
to NDSolve."
}], "Text"],

Cell["The earlier functions", "Subsection"],

Cell[TextData[{
 "The earlier functions of the package, such as ",
 Cell[BoxData[
  ButtonBox["GenericKerrpexBL",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/GenericKerrpexBL"]], 
  "InlineFormula"],
 " and ",
 Cell[BoxData[
  ButtonBox["SchwarzOsculatingOrbitalElements",
   BaseStyle->"Link",
   ButtonData->
    "paclet:OsculatingOrbitalElements/ref/SchwarzOsculatingOrbitalElements"]],
   "InlineFormula"],
 ", keep working but are legacy; ",
 Cell[BoxData[
  ButtonBox["OsculatingInspiral",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/OsculatingInspiral"]], 
  "InlineFormula"],
 ", ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineFormula"],
 " and ",
 Cell[BoxData[
  ButtonBox["FluxModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/FluxModel"]], 
  "InlineFormula"],
 " supersede them."
}], "Text"],

