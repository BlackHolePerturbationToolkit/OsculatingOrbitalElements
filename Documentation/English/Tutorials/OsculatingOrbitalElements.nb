Cell["\<\
The orbit average of a force is a flux. Driven by the force and by its \
averaged flux, an inspiral changes in the same way, apart from oscillations \
of size \[Epsilon]:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"drag", "=", 
   RowBox[{"ForceModel", "[", 
    RowBox[{"\"\<GasDrag\>\"", ",", 
     RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
      FractionBox["1", 
       SuperscriptBox["10", "4"]]}]}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"forced", ",", "fluxed"}], "}"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"OsculatingInspiral", "[", 
       RowBox[{
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<a\>\"", "\[Rule]", "0.5`"}], ",", 
          RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
           FractionBox["1", 
            SuperscriptBox["10", "4"]]}], ",", 
          RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
          RowBox[{"\"\<e\>\"", "\[Rule]", "0.2`"}], ",", 
          RowBox[{"\"\<x\>\"", "\[Rule]", "1"}], ",", "#1"}], "]"}], ",", 
        RowBox[{"IntegrationLimit", "\[Rule]", "1000"}]}], "]"}], "&"}], 
     ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Force\>\"", "\[Rule]", "drag"}], ",", 
      RowBox[{"\"\<Flux\>\"", "\[Rule]", 
       RowBox[{"FluxModel", "[", "drag", "]"}]}]}], "}"}]}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"forced", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"fluxed", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<force\>\"", ",", "\"\<averaged flux\>\""}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<p\>\""}], "}"}]}]}], "]"}]], "Input"],

