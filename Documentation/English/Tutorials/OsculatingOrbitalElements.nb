Cell["\<\
\"StopReason\" says why the integration stopped. By default it stops when p \
comes within \[Epsilon] of the separatrix:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"inspiral", "[", "\"\<StopReason\>\"", "]"}]], "Input"],

Cell[BoxData["\<\"SeparatrixBuffer\"\>"], "Output"],

Cell["Forces", "Subsection"],

Cell[TextData[{
 "A force is a ",
 Cell[BoxData[
  ButtonBox["ForceModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/ForceModel"]], 
  "InlineFormula"],
 ". The built-in models are \"GasDrag\", which needs a \"Coefficient\", \
\"EMConservative\" and \"FastGSF\", a fit to the first-order self-force in \
Schwarzschild. A custom force is a function of the elements, the phases, the \
azimuth and the coordinate time, (a, p, e, x, \[Psi]r, \[Psi]\[Theta], \
\[Phi], t), that returns the covariant components {F_r, F_\[Theta], \
F_\[Phi]}; F_t follows from orthogonality to the velocity. This one is a \
torque, which reduces the angular momentum, and so x:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"torque", "=", 
   RowBox[{"ForceModel", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", "p", ",", "e", ",", "x", ",", "\[Psi]r", ",", 
         "\[Psi]\[Theta]", ",", "\[Phi]", ",", "t"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"\"\<Name\>\"", "\[Rule]", "\"\<Torque\>\""}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tilted", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "0.5`"}], ",", 
       RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["10", "4"]]}], ",", 
       RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
       RowBox[{"\"\<e\>\"", "\[Rule]", "0.2`"}], ",", 
       RowBox[{"\"\<x\>\"", "\[Rule]", "0.8`"}], ",", 
       RowBox[{"\"\<Force\>\"", "\[Rule]", "torque"}]}], "]"}], ",", 
     RowBox[{"IntegrationLimit", "\[Rule]", "3000"}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"tilted", "[", "\"\<x\>\"", "]"}], "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "3000"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<x\>\""}], "}"}]}]}], "]"}]], "Input"],

