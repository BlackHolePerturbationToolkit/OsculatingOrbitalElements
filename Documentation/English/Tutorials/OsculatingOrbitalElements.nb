Cell["\<\
A force is multiplied by the mass ratio \[Epsilon] unless it says otherwise; \
gas drag does not scale with \[Epsilon], since its strength is its \
coefficient. Several forces add:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"both", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{"Association", "[", 
     RowBox[{
      RowBox[{"\"\<a\>\"", "\[Rule]", "0"}], ",", 
      RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
       FractionBox["1", 
        SuperscriptBox["10", "3"]]}], ",", 
      RowBox[{"\"\<p\>\"", "\[Rule]", "10"}], ",", 
      RowBox[{"\"\<e\>\"", "\[Rule]", "0.1`"}], ",", 
      RowBox[{"\"\<x\>\"", "\[Rule]", "1"}], ",", 
      RowBox[{"\"\<Force\>\"", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<FastGSF\>\"", ",", 
         RowBox[{"ForceModel", "[", 
          RowBox[{"\"\<GasDrag\>\"", ",", 
           RowBox[{"\"\<Coefficient\>\"", "\[Rule]", 
            FractionBox["1", 
             SuperscriptBox["10", "4"]]}]}], "]"}]}], "}"}]}]}], "]"}], 
    "]"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"both", "[", "\"\<Domain\>\"", "]"}], ",", 
   RowBox[{"both", "[", "\"\<StopReason\>\"", "]"}]}], "}"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1014.0728393901558`"}], "}"}], 
   ",", "\<\"SeparatrixBuffer\"\>"}], "}"}]], "Output"],

Cell["Fluxes", "Subsection"],

Cell[TextData[{
 "A flux is a ",
 Cell[BoxData[
  ButtonBox["FluxModel",
   BaseStyle->"Link",
   ButtonData->"paclet:OsculatingOrbitalElements/ref/FluxModel"]], 
  "InlineFormula"],
 ": orbit-averaged rates of change of p, e and x, or of the energy, angular \
momentum and Carter constant, with respect to coordinate time. It changes \
only the slowly varying elements, and the phases keep their geodesic rates. \
\"Peters\" is the leading-order gravitational-wave flux:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"peters", "=", 
   RowBox[{"OsculatingInspiral", "[", 
    RowBox[{"Association", "[", 
     RowBox[{
      RowBox[{"\"\<a\>\"", "\[Rule]", "0.9`"}], ",", 
      RowBox[{"\"\<\[Epsilon]\>\"", "\[Rule]", 
       FractionBox["1", 
        SuperscriptBox["10", "2"]]}], ",", 
      RowBox[{"\"\<p\>\"", "\[Rule]", "12"}], ",", 
      RowBox[{"\"\<e\>\"", "\[Rule]", "0.3`"}], ",", 
      RowBox[{"\"\<x\>\"", "\[Rule]", "0.7`"}], ",", 
      RowBox[{"\"\<Flux\>\"", "\[Rule]", "\"\<Peters\>\""}]}], "]"}], "]"}]}],
   ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"peters", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"peters", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{
      RowBox[{"peters", "[", "\"\<Domain\>\"", "]"}], "\[LeftDoubleBracket]", 
      "2", "\[RightDoubleBracket]"}]}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<p\>\"", ",", "\"\<e\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", 
    FractionBox["1", "2"]}]}], "]"}]], "Input"],

