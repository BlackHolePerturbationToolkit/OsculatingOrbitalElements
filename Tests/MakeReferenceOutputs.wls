#!/usr/bin/env wolframscript
(* ::Package:: *)

(* Regenerates Tests/ReferenceOutputs.wl from the cases in RegressionCases.wl.
     wolframscript -file Tests/MakeReferenceOutputs.wls
   Run this only when a change in results is intended, and commit the new file together with that change. *)

Get[FileNameJoin[{DirectoryName[ExpandFileName[First[$ScriptCommandLine]]], "TestSetup.wl"}]];
Get[FileNameJoin[{$testsDirectory, "RegressionCases.wl"}]];

Print["Wolfram version: ", $Version];
Print["Evaluating ", Length[regressionCases], " cases:"];
outputs = Association[Table[Print["  ", label]; label -> regressionCases[label], {label, Keys[regressionCases]}]];

nonNumeric = Select[outputs, !VectorQ[#, MachineNumberQ] &];
If[nonNumeric =!= <||>,
	Print["These cases did not evaluate to lists of machine numbers: ", Keys[nonNumeric]];
	Exit[1]];

(* Record which source the outputs come from. Changes under Tests/ do not affect the outputs. *)
git[args__] := StringTrim[RunProcess[{"git", args}, "StandardOutput", ProcessDirectory -> $repoDirectory]];
commit = git["rev-parse", "--short", "HEAD"] <>
	If[git["status", "--porcelain", "--", ".", ":(exclude)Tests"] === "", "", " with uncommitted changes"];

reference = <|
	"Version" -> $Version,
	"SystemID" -> $SystemID,
	"Commit" -> commit,
	"Date" -> DateString["ISODateTime"],
	"Outputs" -> outputs|>;

(* InputForm must reproduce every machine number exactly *)
text = ToString[reference, InputForm];
If[Flatten[Values[ToExpression[text]["Outputs"]]] - Flatten[Values[outputs]] =!= ConstantArray[0., Length[Flatten[Values[outputs]]]],
	Print["InputForm does not reproduce the outputs exactly."];
	Exit[1]];

file = FileNameJoin[{$testsDirectory, "ReferenceOutputs.wl"}];
Export[file, "(* Generated by MakeReferenceOutputs.wls. Do not edit by hand. *)\n\n" <> text <> "\n", "Text"];
Print["Wrote ", file, " (commit ", commit, ")"];
