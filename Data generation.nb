Cell[CellGroupData[{

Cell["forces definitions Kerr", "Subsection",
 CellChangeTimes->{{3.980240420764295*^9, 
  3.980240429293644*^9}},ExpressionUUID->"21b4e32d-047d-4961-b1a1-\
bf2d70f804c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fr2", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDragVec2", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", ",",
       " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<fr\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f\[Theta]2", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDragVec2", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", ",",
       " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<f\[Theta]\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f\[Phi]2", "[", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDragVec2", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", ",",
       " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<f\[Phi]\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"6d369751-a876-4a57-b047-e90a6f796cd3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["forces definition Schwarzschild", "Subsection",
 CellChangeTimes->{{3.9802404468784323`*^9, 
  3.980240476109568*^9}},ExpressionUUID->"a786f4be-fe1f-48da-bc40-\
95cf29675057"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Fr", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}], 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Fr", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", 
         FractionBox[
          RowBox[{"p", "-", "r"}], 
          RowBox[{"e", " ", "r"}]]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F\[Phi]", "[", 
    RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
     RowBox[{"p", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}], ";"}]}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"3c82e0f4-f26e-465c-954c-bd5714f3c1a9"],

Cell[CellGroupData[{

Cell["\<\
data generation functions (it will create a folder data Kerr or data \
Schwarzschild in your UserDocumentsDirectory)\
\>", "Subsubsection",
 CellChangeTimes->{{3.980240548186166*^9, 3.9802405576677923`*^9}, {
  3.980241002934536*^9, 
  3.980241073185025*^9}},ExpressionUUID->"f8969b65-7a9d-43a6-988d-\
b72349db9d1c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"datagenerationKerr", "[", 
   RowBox[{
   "\[Eta]_", ",", "a0_", " ", ",", "p0_", " ", ",", "e0_", ",", "x0_", ",", 
    "\[Psi]r0_", ",", "\[Psi]\[Theta]0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time1", ",", "kerrOrbitTPVecLessArg2", ",", "data"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time1", ",", "kerrOrbitTPVecLessArg2"}], "}"}], "=", 
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"KerrOsculatingOrbitalElementsTPVecLessArg1", "[", 
         RowBox[{
         "\[Eta]", ",", "a0", ",", " ", "p0", ",", " ", "e0", ",", " ", "x0", 
          ",", " ", "\[Psi]r0", ",", " ", "\[Psi]\[Theta]0", ",", " ", 
          RowBox[{"Force", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            RowBox[{"fr2", ",", "f\[Theta]2", ",", "f\[Phi]2"}], "}"}]}]}], 
         "]"}], "//", "Timing"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<p\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<e\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<x\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<En\>\"", "]"}], "[", 
           "#", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<L\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<Q\>\"", "]"}], "[", 
           "#", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<\[Psi]r\>\"", "]"}], "[",
            "#", "]"}], ",", 
          RowBox[{
           RowBox[{
           "kerrOrbitTPVecLessArg2", "[", "\"\<\[Psi]\[Theta]\>\"", "]"}], "[",
            "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<\[Phi]\>\"", "]"}], "[",
            "#", "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"First", "[", 
        RowBox[{
         RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<En\>\"", "]"}], 
         "@", "\"\<Coordinates\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"$UserDocumentsDirectory", ",", "\"\<Kerr\>\"", ",", 
          RowBox[{"DateString", "[", "Today", "]"}], ",", 
          RowBox[{"\"\<Kerr_sol\>\"", "<>", "\"\<_a=\>\"", "<>", 
           RowBox[{"ToString", "[", "a0", "]"}], "<>", "\"\<_e=\>\"", "<>", 
           RowBox[{"ToString", "[", "e0", "]"}], "<>", "\"\<_p=\>\"", "<>", 
           RowBox[{"ToString", "[", "p0", "]"}], "<>", "\"\<_x=\>\"", "<>", 
           RowBox[{"ToString", "[", "x0", "]"}], "<>", "\"\<_\[Psi]r0=\>\"", "<>", 
           RowBox[{"ToString", "[", "\[Psi]r0", "]"}], 
           "<>", "\"\<_\[Psi]\[Theta]0=\>\"", "<>", 
           RowBox[{"ToString", "[", "\[Psi]\[Theta]0", "]"}], 
           "<>", "\"\<_evaluation_time=\>\"", "<>", 
           RowBox[{"ToString", "[", "time1", "]"}], "<>", "\"\<c_\>\"", "<>", 
           
           RowBox[{"ToString", "[", "$SystemID", "]"}], "<>", 
           " ", "\"\<.dat\>\""}]}], "}"}], "]"}], ",", "data"}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datagenerationSchwarzschild", "[", 
   RowBox[{"\[Eta]_", ",", " ", "p0_", " ", ",", "e0_", ",", "\[Xi]0_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time1", ",", "SchwOrbitTP", ",", "data"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time1", ",", "SchwOrbitTP"}], "}"}], "=", 
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"SchwarzOsculatingOrbitalElementsTP", "[", 
         RowBox[{
         "\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0", ",", 
          " ", 
          RowBox[{"Force", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            RowBox[{"Fr", ",", " ", "F\[Phi]"}], "}"}]}]}], "]"}], "//", 
        "Timing"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<p\>\"", "]"}], "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<e\>\"", "]"}], "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<\[Xi]\>\"", "]"}], "[", "#", 
           "]"}], ",", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<\[Phi]\>\"", "]"}], "[", "#", 
           "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"First", "[", 
        RowBox[{
         RowBox[{"SchwOrbitTP", "[", "\"\<p\>\"", "]"}], 
         "@", "\"\<Coordinates\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"$UserDocumentsDirectory", ",", "\"\<Schwarzschild\>\"", ",", 
          RowBox[{"DateString", "[", "Today", "]"}], ",", 
          RowBox[{"\"\<Schwarzschild\>\"", "<>", "\"\<_e=\>\"", "<>", 
           RowBox[{"ToString", "[", "e0", "]"}], "<>", "\"\<_p=\>\"", "<>", 
           RowBox[{"ToString", "[", "p0", "]"}], "<>", "\"\<_\[Xi]0=\>\"", "<>", 
           RowBox[{"ToString", "[", "\[Xi]0", "]"}], 
           "<>", "\"\<_evaluation_time=\>\"", "<>", 
           RowBox[{"ToString", "[", "time1", "]"}], "<>", "\"\<c_\>\"", "<>", 
           
           RowBox[{"ToString", "[", "$SystemID", "]"}], "<>", 
           " ", "\"\<.dat\>\""}]}], "}"}], "]"}], ",", "data"}], "]"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.980240584149042*^9, 3.98024058486012*^9}, {
  3.9802406194262257`*^9, 3.9802407148038273`*^9}, {3.9802408634505*^9, 
  3.980240865587019*^9}, {3.9802409643881197`*^9, 3.980240968109242*^9}, {
  3.9802412548206673`*^9, 3.980241269004899*^9}, {3.980241304631401*^9, 
  3.9802413337110147`*^9}, {3.9802414154828463`*^9, 3.980241419028824*^9}, {
  3.980241549483341*^9, 3.980241566941148*^9}, {3.980242220367298*^9, 
  3.9802422264710903`*^9}, {3.980331165804591*^9, 3.9803312107574778`*^9}, {
  3.9803315745837193`*^9, 3.980331602828154*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"953dc4da-adc3-4b21-a470-699946afee7c"]
