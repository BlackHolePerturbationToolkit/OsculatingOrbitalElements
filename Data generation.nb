Cell[BoxData[
 RowBox[{
  RowBox[{"ParallelTable", "[", 
   RowBox[{
    RowBox[{"datagenerationKerr", "[", 
     RowBox[{
     "\[Eta]", ",", "a0", " ", ",", "p0", " ", ",", "i", ",", "x0", ",", 
      "\[Psi]r0", ",", "\[Psi]\[Theta]0"}], "]"}], ",", 
