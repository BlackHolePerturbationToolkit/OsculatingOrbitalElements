        RowBox[{
         RowBox[{"pex", "[", "\"\<r\>\"", "]"}], "[", "\[Chi]", "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"pex", "[", "\"\<\[Theta]\>\"", "]"}], "[", "\[Chi]", "]"}],
          "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"pex", "[", "\"\<\[Phi]\>\"", "]"}], "[", "\[Chi]", "]"}], 
         "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"pex", "[", "\"\<r\>\"", "]"}], "[", "\[Chi]", "]"}], " ", 
