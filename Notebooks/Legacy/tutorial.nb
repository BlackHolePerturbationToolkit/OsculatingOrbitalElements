Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"pex", "[", "\"\<r\>\"", "]"}], "[", "\[Chi]", "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"pex", "[", "\"\<\[Theta]\>\"", "]"}], "[", "\[Chi]", "]"}],
          "]"}], " ", 
