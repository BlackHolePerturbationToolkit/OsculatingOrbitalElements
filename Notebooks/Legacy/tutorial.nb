Notebook[{

Cell[CellGroupData[{
Cell["Tutorial: Using the Osculating Orbital Elements Package", "Title"],

Cell[CellGroupData[{

Cell["Importing the Package", "Section"],

Cell[TextData[{
 "The package is imported using the following command. This package requires \
the KerrGeodesics Package, which can be found at ",
 ButtonBox["github.com/BlackHolePerturbationToolkit/KerrGeodesics",
  BaseStyle->"Hyperlink",
  ButtonData->{
   "github.com/BlackHolePerturbationToolkit/KerrGeodesics", None}]
}], "Text"],

Cell[BoxData[
 RowBox[{"<<", "OsculatingOrbitalElements`"}]], "Input"],

Cell[BoxData[
 RowBox[{"<<", "KerrGeodesics`"}]], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Schwarzschild Spacetime", "Section"],

Cell[CellGroupData[{

Cell["Information", "Subsection"],

Cell[CellGroupData[{

Cell["Method and Notation", "Subsubsection"],

Cell[TextData[{
 "This code used the method of Osculating Orbital Elements first derived in \
Pound and Poisson[1]. This code adopts the notation used in Warburton et al \
[2]. \n\[Eta] is the ratio of the compact object mass to the background black \
hole\[CloseCurlyQuote]s mass.\np is the semi-lattice rectum\ne is the \
eccentricity\n\[Xi] is the phase variable, defined by \[Xi] = \[Chi] - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "0"], TraditionalForm]]],
 ".\nThe equations are integrated w.r.t the Darwin Parameter \[Chi].\nFr and \
F\[Phi] are contrvarient componets of the acceleration."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SchwarzOsculatingOrbitalElements", "Subsubsection"],

Cell[BoxData[
 RowBox[{"?", "SchwarzOsculatingOrbitalElements"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "SchwarzOsculatingOrbitalElementsTP"}]], "Input"],

Cell["SchwarzOsculatingOrbitalElements has the following options.", "Text"],

Cell[BoxData[
 RowBox[{"?", "Force"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "IntegrationLimit"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "AccuracyGoal"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "PrecisionGoal"}]], "Input"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["User Specified Model", "Subsection"],

Cell["\<\
First, we are going to define force components for use with \
SchwarzOsculatingOrbitalElements. These components need to be functions of p, \
e and \[Xi].\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\"\<Fr\>\"", "\[Rule]", 
   RowBox[{
    RowBox[{"-", "e"}], " ", 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"-", "6"}], "+", "p", "-", 
       RowBox[{"2", " ", "e", " ", 
        RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
      RowBox[{"p", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]], " ", 
    RowBox[{"Sin", "[", "\[Xi]", "]"}]}]}], ",", 
  RowBox[{"\"\<F\[Phi]\>\"", "\[Rule]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
     RowBox[{"p", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}]}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Fr", "[", 
    RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"-", "e"}], " ", 
    RowBox[{"Sin", "[", "\[Xi]", "]"}], 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"-", "6"}], "+", "p", "-", 
       RowBox[{"2", " ", "e", " ", 
        RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
      RowBox[{"p", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F\[Phi]", "[", 
    RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
     RowBox[{"p", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}], ";"}]}], "Input"],

Cell["\<\
Next, we specify the mass ratio along with initial conditions of the orbit.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eta]", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "4"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p0", "=", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e0", "=", "0.9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Xi]0", "=", "0"}], ";"}]}], "Input"],

Cell["\<\
Now we solve the osculating geodesic equations and save the result to the \
symbol \[OpenCurlyQuote]orbit\[CloseCurlyQuote] for  \[Chi] parametrization \
and \[OpenCurlyQuote]orbitT\[CloseCurlyQuote] for coordinate time \
parametrization \
\>", "Text"],

Cell[BoxData[
 RowBox[{"orbit", " ", "=", " ", 
  RowBox[{
   RowBox[{"SchwarzOsculatingOrbitalElements", "[", 
    RowBox[{
    "\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0", ",", " ", 
     RowBox[{"Force", " ", "\[Rule]", " ", 
      RowBox[{"{", 
       RowBox[{"Fr", ",", " ", "F\[Phi]"}], "}"}]}]}], "]"}], "//", 
   "Timing"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"orbitT", " ", "=", " ", 
  RowBox[{"SchwarzOsculatingOrbitalElementsTP", "[", 
   RowBox[{
   "\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0", ",", " ", 
    RowBox[{"Force", " ", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"Fr", ",", " ", "F\[Phi]"}], "}"}]}]}], "]"}]}]], "Input"],

Cell["\<\
The output is an association. You can access these functions using the \
following syntax:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"orbitT", "[", "\"\<r\>\"", "]"}], "[", "40", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"orbit", "[", "\"\<r\>\"", "]"}], "[", "40", "]"}]], "Input"],

Cell["To find the limit so that we can plot the whole trajectory", "Text"],

Cell[BoxData[{
 RowBox[{"plotLimitXi", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"orbit", "[", "\"\<t\>\"", "]"}], "[", "\"\<Domain\>\"", "]"}], 
   "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"plotLimitT", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"orbitT", "[", "\"\<p\>\"", "]"}], "[", "\"\<Domain\>\"", "]"}], 
   "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "Input"],

Cell["Plots of different parameters for both parametrisations ", "Text"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"orbit", "[", "\"\<t\>\"", "]"}], "[", "\[Chi]", "]"}], ",", 
       RowBox[{
        RowBox[{"orbit", "[", "\"\<p\>\"", "]"}], "[", "\[Chi]", "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Chi]", ",", " ", "0", ",", " ", "plotLimitXi"}], "}"}], ",", 
     " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<p\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{
        RowBox[{"orbitT", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}]}], "}"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "plotLimitT"}], "}"}], ",", " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Orange"}], "}"}]}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"orbit", "[", "\"\<t\>\"", "]"}], "[", "\[Chi]", "]"}], ",", 
       RowBox[{
        RowBox[{"orbit", "[", "\"\<e\>\"", "]"}], "[", "\[Chi]", "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Chi]", ",", " ", "0", ",", " ", "plotLimitXi"}], "}"}], ",", 
     " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<e\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{
        RowBox[{"orbitT", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], "}"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "plotLimitT"}], "}"}], ",", " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Orange"}], "}"}]}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"orbit", "[", "\"\<t\>\"", "]"}], "[", "\[Chi]", "]"}], ",", 
       RowBox[{
        RowBox[{"orbit", "[", "\"\<\[Phi]\>\"", "]"}], "[", "\[Chi]", "]"}]}],
       "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Chi]", ",", " ", "0", ",", " ", "plotLimitXi"}], "}"}], ",", 
