       RowBox[{"Dashed", ",", "Orange"}], "}"}]}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "Disk"}]], "Input"],

Cell["Comparison between unperturbed orbit and perturbed", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"phi", "[", "\[Chi]_", "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    FractionBox[
     SuperscriptBox["p0", 
      FractionBox["1", "2"]], 
     RowBox[{"Sqrt", "[", 
      RowBox[{"p0", "-", "6", "-", 
       RowBox[{"2", " ", "e0", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"xi", "+", "\[Xi]0"}], "]"}]}]}], "]"}]], ",", 
    RowBox[{"{", 
     RowBox[{"xi", ",", "0", ",", "\[Chi]"}], "}"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"orbit", "[", "\"\<r\>\"", "]"}], "[", "\[Chi]", "]"}], 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"orbit", "[", "\"\<\[Phi]\>\"", "]"}], "[", "\[Chi]", 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"orbit", "[", "\"\<r\>\"", "]"}], "[", "\[Chi]", "]"}], 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"orbit", "[", "\"\<\[Phi]\>\"", "]"}], "[", "\[Chi]", 
             "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"p0", " "}], 
            RowBox[{"1", "+", 
             RowBox[{"e0", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Chi]", "+", "\[Xi]0"}], "]"}]}]}]], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"phi", "[", "\[Chi]", "]"}], "]"}]}], ",", " ", 
          RowBox[{
           FractionBox["p0", 
            RowBox[{"1", "+", 
             RowBox[{"e0", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Chi]", "+", "\[Xi]0"}], "]"}]}]}]], 
           RowBox[{"Sin", "[", 
