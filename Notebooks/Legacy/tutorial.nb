       RowBox[{"\"\<t\>\"", ",", "\"\<\[Phi]\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{
        RowBox[{"orbitT", "[", "\"\<\[Phi]\>\"", "]"}], "[", "t", "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "plotLimitT"}], "}"}], ",", " ", 
