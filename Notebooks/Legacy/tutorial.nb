Cell[CellGroupData[{

Cell["Included Models", "Subsection"],

Cell[CellGroupData[{

Cell["SchwarzGasDrag", "Subsubsection"],

Cell["\<\
Not specifying a Force option means that SchwarzOsculatingOrbitalElements \
uses the SchwarzGasDrag model.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"?", "SchwarzGasDrag"}]], "Input"],

Cell[BoxData[
 RowBox[{"SchwarzGasDrag", "[", 
  RowBox[{"p", ",", " ", "e", ",", " ", "\[Xi]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"SchwarzOsculatingOrbitalElements", "[", 
  RowBox[{"\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0"}], 
  "]"}]], "Input"],

Cell["One can also specify this option explicitly.", "Text"],

Cell[BoxData[
 RowBox[{"SchwarzOsculatingOrbitalElements", "[", 
  RowBox[{
  "\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0", ",", " ", 
   RowBox[{"Force", " ", "\[Rule]", " ", "SchwarzGasDrag"}]}], "]"}]], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SchwarzFastGSF", "Subsubsection"],

Cell["\<\
One can also choose to use SchwarzFastGSF model. Note that this model is \
valid for p <= 12 and e<= 0.2. \
\>", "Text"],

Cell[BoxData[
 RowBox[{"?", "SchwarzFastGSF"}]], "Input"],

Cell[BoxData[
 RowBox[{"SchwarzFastGSF", "[", 
  RowBox[{"p", ",", "e", ",", "\[Xi]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"SchwarzOsculatingOrbitalElements", "[", 
  RowBox[{
  "\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0", ",", " ", 
   RowBox[{"Force", " ", "\[Rule]", " ", "SchwarzFastGSF"}]}], "]"}]], "Input"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Kerr Spacetime", "Section"],

Cell[BoxData[""], "Input"],

Cell[CellGroupData[{

Cell["Information", "Subsection"],

Cell[CellGroupData[{

Cell["Method and Notation", "Subsubsection"],

Cell[TextData[{
 "This code used the method of Osculating Orbital Elements for Kerr first \
derived in Gair et al [3] and uses the notation given in that paper.\n\[Eta] \
is the ratio of the compact object mass to the background black hole\
\[CloseCurlyQuote]s mass.\np is the semi-lattice rectum.\ne is the \
eccentricity.\nx is Cos[\[Theta]inc].\nEn is orbital energy.\nL angular \
momentum about the symmetry axis.\nK is the modified Carter Constant defined \
by K = Q + (L - a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"En", ")"}], "2"], TraditionalForm]]],
 "\n\[Psi]r is the radial phase variable.\n\[Psi]\[Theta] is the polar phase \
variable.\nThe equations are integrated w.r.t Mino time \[Lambda].\nat, ar, a\
\[Theta], a\[Phi] are covariant components of the acceleration.\nft, fr, f\
\[Theta], f\[Phi] are vector components of the acceleration."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["KerrOsculatingOrbitalElements", "Subsubsection"],

Cell[BoxData[
 RowBox[{"?", "KerrOsculatingOrbitalElements"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "GenericKerrpexBL"}]], "Input"],

Cell["KerrOsculatingOrbitalElements has the following options.", "Text"],

Cell[BoxData[
 RowBox[{"?", "Force"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "IntegrationLimit"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "AccuracyGoal"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "PrecisionGoal"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", " ", "TimeMonitor"}]], "Input"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["User Specified Model", "Subsection"],

Cell["\<\
First, we are going to define force components for use with \
KerrOsculatingOrbitalElements. These components need to be functions of En, \
L, K, \[Psi]r and \[Psi]\[Theta]. We\[CloseCurlyQuote]re just going to use \
the KerrGasDrag model for this example\
\>", "Text"],

Cell["Force in covariant form", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"at", "[", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<at\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ar", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<ar\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a\[Theta]", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<a\[Theta]\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a\[Phi]", "[", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<a\[Phi]\>\"", "]"}]}], 
  ";"}]}], "Input"],

Cell["or in vector form", "Text"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fr", "[", " ", 
      RowBox[{
      "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
       "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"KerrGasDragVec", "[", 
       RowBox[{
       "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r",
         ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<fr\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f\[Theta]", "[", " ", 
      RowBox[{
      "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
       "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"KerrGasDragVec", "[", 
       RowBox[{
       "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r",
         ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<f\[Theta]\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f\[Phi]", "[", 
      RowBox[{
      "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
       "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"KerrGasDragVec", "[", 
       RowBox[{
       "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r",
         ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<f\[Phi]\>\"", "]"}]}],
     ";"}]}]}]], "Input"],

Cell["\<\
Next, we specify the mass ratio, the spin and the initial conditions of the \
orbit.\[LineSeparator]\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eta]", " ", "=", " ", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a0", " ", "=", " ", "0.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", " ", "=", " ", "40"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e0", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"\[Pi]", "/", "6"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]r0", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]\[Theta]0", " ", "=", "0"}], ";"}]}], "Input"],

Cell["\<\
Now we solve the osculating geodesic equations and save the result to the \
symbols \[OpenCurlyQuote]ELK\[CloseCurlyQuote], \[OpenCurlyQuote]pex\
\[CloseCurlyQuote] and  for different types of parametrisation\
\>", "Text"],

Cell["Comparison between ELK and pex ", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"(", 
   RowBox[{"ELK", " ", "=", " ", 
    RowBox[{"KerrOsculatingOrbitalElements", "[", 
     RowBox[{
     "\[Eta]", ",", "a0", ",", " ", "p0", ",", " ", "e0", ",", " ", "x0", ",",
       " ", "\[Psi]r0", ",", " ", "\[Psi]\[Theta]0", ",", " ", 
      RowBox[{"Force", " ", "\[Rule]", " ", 
       RowBox[{"{", 
        RowBox[{"at", ",", "ar", ",", "a\[Theta]", ",", "a\[Phi]"}], "}"}]}], 
      ",", 
      RowBox[{"Parametrisation", "->", "\"\<CoordinateTime\>\""}], ",", " ", 
      RowBox[{"TimeMonitor", "->", "False"}]}], "]"}]}], ")"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{"pex", " ", "=", " ", 
    RowBox[{"GenericKerrpexBL", "[", 
     RowBox[{
     "\[Eta]", ",", "a0", ",", "p0", ",", "e0", ",", "x0", ",", "\[Psi]r0", 
      ",", " ", "\[Psi]\[Theta]0", ",", 
      RowBox[{"Parametrisation", "->", "\"\<CoordinateTime\>\""}]}], "]"}]}], 
   "]"}], ";"}]}], "Input"],

Cell[BoxData[
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pex", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], "-", " ", 
       RowBox[{
        RowBox[{"ELK", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pex", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}], "-", " ", 
        RowBox[{
         RowBox[{"ELK", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], "]"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pex", "[", "\"\<x\>\"", "]"}], "[", "t", "]"}], "-", " ", 
        RowBox[{
         RowBox[{"ELK", "[", "\"\<x\>\"", "]"}], "[", "t", "]"}]}], "]"}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"ELK", "[", "\"\<limit\>\"", "]"}]}], "}"}]}], "]"}]], "Input"],

Cell["\<\
KerrOsculatingOrbitalElements has several options as example ForceUpDown -> \
\"Up\" mean that force components are vectors (only fr, f\[Theta], f\[Phi])\
\>", "Text"],

Cell[BoxData[
 RowBox[{"ELKupMino", "=", 
  RowBox[{"KerrOsculatingOrbitalElements", "[", 
   RowBox[{
   "\[Eta]", ",", "a0", ",", "p0", ",", "e0", ",", "x0", ",", "\[Psi]r0", ",",
     "\[Psi]\[Theta]0", ",", 
    RowBox[{"Force", "->", "KerrGasDragVec"}], ",", 
    RowBox[{"ForceUpDown", "->", "\"\<Up\>\""}], ",", 
    RowBox[{"Parametrisation", "->", "\"\<Mino\>\""}]}], "]"}]}]], "Input"],

Cell["comparison with previous ones ", "Text"],

Cell[BoxData[
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pex", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], "-", " ", 
       RowBox[{
        RowBox[{"ELK", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pex", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}], "-", " ", 
        RowBox[{
         RowBox[{"ELK", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], "]"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pex", "[", "\"\<x\>\"", "]"}], "[", "t", "]"}], "-", " ", 
        RowBox[{
         RowBox[{"ELK", "[", "\"\<x\>\"", "]"}], "[", "t", "]"}]}], "]"}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"ELK", "[", "\"\<limit\>\"", "]"}]}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[""], "Input"],

Cell["\<\
The output is an association . You can access these functions using the \
following syntax :\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pex", "[", "\"\<r\>\"", "]"}], "[", "100", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ELK", "[", "\"\<p\>\"", "]"}], "[", "5", "]"}]], "Input"],

Cell["To find the limit so that we can plot the whole trajectory", "Text"],

Cell[BoxData[{
 RowBox[{"plotLimitpex", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"pex", "[", "\"\<p\>\"", "]"}], "[", "\"\<Domain\>\"", "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"plotLimitELKMino", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"ELKupMino", "[", "\"\<En\>\"", "]"}], "[", "\"\<Domain\>\"", 
    "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]"}], "Input"],

Cell["Plots of different parameters for both parametrisations ", "Text"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"ELKupMino", "[", "\"\<p\>\"", "]"}], "[", "\[Chi]", "]"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"ELKupMino", "[", "\"\<e\>\"", "]"}], "[", "\[Chi]", "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Chi]", ",", " ", "0", ",", " ", "plotLimitELKMino"}], "}"}], 
     ",", " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", "\"\<e\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"pex", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"pex", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "plotLimitpex"}], "}"}], ",", " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Green", ",", "Dashed"}], "}"}]}]}], "]"}]}], " ", 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"ELKupMino", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"ELKupMino", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "plotLimitELKMino"}], "}"}], ",", 
     " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", "\"\<e\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", "Red", "}"}]}]}], "]"}], ",", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"pex", "[", "\"\<p\>\"", "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"pex", "[", "\"\<e\>\"", "]"}], "[", "t", "]"}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "plotLimitpex"}], "}"}], ",", " ", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
