Notebook[{

Cell[CellGroupData[{
Cell["Data generation file", "Title"],

Cell[CellGroupData[{

Cell["defining all functions we need:", "Section"],

Cell[CellGroupData[{

Cell["package setup ", "Subsection"],

Cell[BoxData[{
 RowBox[{"SetDirectory", "[", 
  RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"<<", "OsculatingOrbitalElements`"}]}], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["forces definitions Kerr", "Subsection"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fr2", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDragVec2", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<fr\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f\[Theta]2", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDragVec2", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<f\[Theta]\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f\[Phi]2", "[", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDragVec2", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<f\[Phi]\>\"", "]"}]}], 
  ";"}]}], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["forces definition Schwarzschild", "Subsection"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Fr", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}], 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Fr", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", 
         FractionBox[
          RowBox[{"p", "-", "r"}], 
          RowBox[{"e", " ", "r"}]]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F\[Phi]", "[", 
    RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
     RowBox[{"p", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}], ";"}]}], "Input"],

Cell[CellGroupData[{

Cell["\<\
data generation functions (it will create a folder data Kerr or data \
Schwarzschild in your UserDocumentsDirectory)\
\>", "Subsubsection"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"datagenerationKerr", "[", 
   RowBox[{
   "\[Eta]_", ",", "a0_", " ", ",", "p0_", " ", ",", "e0_", ",", "x0_", ",", 
    "\[Psi]r0_", ",", "\[Psi]\[Theta]0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time1", ",", "kerrOrbitTPVecLessArg2", ",", "data"}], "}"}], 
    ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time1", ",", "kerrOrbitTPVecLessArg2"}], "}"}], "=", 
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"KerrOsculatingOrbitalElementsTPVecLessArg1", "[", 
         RowBox[{
         "\[Eta]", ",", "a0", ",", " ", "p0", ",", " ", "e0", ",", " ", "x0", 
          ",", " ", "\[Psi]r0", ",", " ", "\[Psi]\[Theta]0", ",", " ", 
          RowBox[{"Force", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            RowBox[{"fr2", ",", "f\[Theta]2", ",", "f\[Phi]2"}], "}"}]}]}], 
         "]"}], "//", "Timing"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<p\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<e\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<x\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<En\>\"", "]"}], "[", 
           "#", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<L\>\"", "]"}], "[", 
           "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<Q\>\"", "]"}], "[", 
           "#", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<\[Psi]r\>\"", "]"}], 
           "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{
           "kerrOrbitTPVecLessArg2", "[", "\"\<\[Psi]\[Theta]\>\"", "]"}], 
           "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<\[Phi]\>\"", "]"}], 
           "[", "#", "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"First", "[", 
        RowBox[{
         RowBox[{"kerrOrbitTPVecLessArg2", "[", "\"\<En\>\"", "]"}], "@", 
         "\"\<Coordinates\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"$UserDocumentsDirectory", ",", "\"\<Kerr\>\"", ",", 
          RowBox[{"DateString", "[", "Today", "]"}], ",", 
          RowBox[{"\"\<Kerr_sol\>\"", "<>", "\"\<_a=\>\"", "<>", 
           RowBox[{"ToString", "[", "a0", "]"}], "<>", "\"\<_e=\>\"", "<>", 
           RowBox[{"ToString", "[", "e0", "]"}], "<>", "\"\<_p=\>\"", "<>", 
           RowBox[{"ToString", "[", "p0", "]"}], "<>", "\"\<_x=\>\"", "<>", 
           RowBox[{"ToString", "[", "x0", "]"}], "<>", "\"\<_\[Psi]r0=\>\"", "<>", 
           RowBox[{"ToString", "[", "\[Psi]r0", "]"}], "<>", 
           "\"\<_\[Psi]\[Theta]0=\>\"", "<>", 
           RowBox[{"ToString", "[", "\[Psi]\[Theta]0", "]"}], "<>", 
           "\"\<_evaluation_time=\>\"", "<>", 
           RowBox[{"ToString", "[", "time1", "]"}], "<>", "\"\<c_\>\"", "<>", 
           
           RowBox[{"ToString", "[", "$SystemID", "]"}], "<>", " ", 
           "\"\<.dat\>\""}]}], "}"}], "]"}], ",", "data"}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datagenerationSchwarzschild", "[", 
   RowBox[{"\[Eta]_", ",", " ", "p0_", " ", ",", "e0_", ",", "\[Xi]0_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time1", ",", "SchwOrbitTP", ",", "data"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time1", ",", "SchwOrbitTP"}], "}"}], "=", 
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"SchwarzOsculatingOrbitalElementsTP", "[", 
         RowBox[{
         "\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0", ",", 
          " ", 
          RowBox[{"Force", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            RowBox[{"Fr", ",", " ", "F\[Phi]"}], "}"}]}]}], "]"}], "//", 
        "Timing"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<p\>\"", "]"}], "[", "#", "]"}], 
          ",", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<e\>\"", "]"}], "[", "#", "]"}], 
          ",", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<\[Xi]\>\"", "]"}], "[", "#", 
           "]"}], ",", 
          RowBox[{
           RowBox[{"SchwOrbitTP", "[", "\"\<\[Phi]\>\"", "]"}], "[", "#", 
           "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"First", "[", 
        RowBox[{
         RowBox[{"SchwOrbitTP", "[", "\"\<p\>\"", "]"}], "@", 
         "\"\<Coordinates\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"$UserDocumentsDirectory", ",", "\"\<Schwarzschild\>\"", ",", 
          RowBox[{"DateString", "[", "Today", "]"}], ",", 
          RowBox[{"\"\<Schwarzschild\>\"", "<>", "\"\<_e=\>\"", "<>", 
           RowBox[{"ToString", "[", "e0", "]"}], "<>", "\"\<_p=\>\"", "<>", 
           RowBox[{"ToString", "[", "p0", "]"}], "<>", "\"\<_\[Xi]0=\>\"", "<>", 
           RowBox[{"ToString", "[", "\[Xi]0", "]"}], "<>", 
           "\"\<_evaluation_time=\>\"", "<>", 
           RowBox[{"ToString", "[", "time1", "]"}], "<>", "\"\<c_\>\"", "<>", 
           
           RowBox[{"ToString", "[", "$SystemID", "]"}], "<>", " ", 
           "\"\<.dat\>\""}]}], "}"}], "]"}], ",", "data"}], "]"}]}]}], 
   "]"}]}]}], "Input"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

