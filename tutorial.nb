a4e90be67a8d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"(", 
   RowBox[{"ELK", " ", "=", " ", 
    RowBox[{"KerrOsculatingOrbitalElements", "[", 
     RowBox[{
     "\[Eta]", ",", "a0", ",", " ", "p0", ",", " ", "e0", ",", " ", "x0", ",",
       " ", "\[Psi]r0", ",", " ", "\[Psi]\[Theta]0", ",", " ", 
      RowBox[{"Force", " ", "\[Rule]", " ", 
       RowBox[{"{", 
        RowBox[{"at", ",", "ar", ",", "a\[Theta]", ",", "a\[Phi]"}], "}"}]}], 
      ",", 
      RowBox[{"Parametrisation", "->", "\"\<CoordinateTime\>\""}], ",", " ", 
      RowBox[{"TimeMonitor", "->", "False"}]}], "]"}]}], ")"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{"pex", " ", "=", " ", 
    RowBox[{"GenericKerrpexBL", "[", 
     RowBox[{
     "\[Eta]", ",", "a0", ",", "p0", ",", "e0", ",", "x0", ",", "\[Psi]r0", ",",
       " ", "\[Psi]\[Theta]0", ",", 
      RowBox[{"Parametrisation", "->", "\"\<CoordinateTime\>\""}]}], "]"}]}], 
   "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.7778980538168306`*^9, 3.777898094847129*^9}, {
