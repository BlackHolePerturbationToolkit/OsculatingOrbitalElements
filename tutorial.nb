                    StripOnInput->False],
                    "\"Definitions\"",
                    TooltipStyle->"TextStyling"],
                    Annotation[#, "Definitions", "Tooltip"]& ], GridBox[{
                    {
                    RowBox[{
                    RowBox[{"SchwarzGasDrag", "[", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`p_", ",", 
                    "OsculatingOrbitalElements`Private`e_", ",", 
                    "OsculatingOrbitalElements`Private`\[Xi]_", ",", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`M_", ":", "1"}]}], 
                    "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`Fr", ",", 
                    "OsculatingOrbitalElements`Private`F\[Phi]", ",", 
                    "OsculatingOrbitalElements`Private`ur", ",", 
                    "OsculatingOrbitalElements`Private`u\[Phi]"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"OsculatingOrbitalElements`Private`ur", "=", 
                    RowBox[{"OsculatingOrbitalElements`Private`e", " ", 
                    RowBox[{
                    "Sin", "[", "OsculatingOrbitalElements`Private`\[Xi]", 
                    "]"}], " ", 
                    SqrtBox[
                    FractionBox[
                    RowBox[{"OsculatingOrbitalElements`Private`p", "-", "6", "-", 
                    RowBox[{"2", " ", "OsculatingOrbitalElements`Private`e", " ", 
                    RowBox[{
                    "Cos", "[", "OsculatingOrbitalElements`Private`\[Xi]", 
                    "]"}]}]}], 
                    RowBox[{"OsculatingOrbitalElements`Private`p", " ", 
                    RowBox[{"(", 
                    RowBox[{"OsculatingOrbitalElements`Private`p", "-", "3", "-", 
                    
                    SuperscriptBox["OsculatingOrbitalElements`Private`e", 
                    "2"]}], ")"}]}]]]}]}], ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`u\[Phi]", "=", 
                    FractionBox[
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"OsculatingOrbitalElements`Private`e", " ", 
                    RowBox[{
                    "Cos", "[", "OsculatingOrbitalElements`Private`\[Xi]", 
                    "]"}]}]}], ")"}], "2"], 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`p", " ", 
                    "OsculatingOrbitalElements`Private`M", " ", 
                    SqrtBox[
                    RowBox[{"OsculatingOrbitalElements`Private`p", "-", "3", "-", 
                    
                    SuperscriptBox["OsculatingOrbitalElements`Private`e", 
                    "2"]}]]}]]}], ";", 
                    RowBox[{"Association", "[", 
                    RowBox[{
                    RowBox[{"\<\"Fr\"\>", "\[Rule]", 
                    RowBox[{"-", "OsculatingOrbitalElements`Private`ur"}]}], ",", 
                    RowBox[{"\<\"F\[Phi]\"\>", "\[Rule]", 
                    RowBox[{
                    "-", "OsculatingOrbitalElements`Private`u\[Phi]"}]}]}], 
                    "]"}]}]}], "]"}]}]}
