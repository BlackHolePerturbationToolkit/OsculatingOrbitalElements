Cell[CellGroupData[{

Cell["User Specified Model", "Subsection",
 CellChangeTimes->{{3.7778967548077145`*^9, 
  3.7778967718970165`*^9}},ExpressionUUID->"4fc91180-cbf9-4fa7-b143-\
beb39f2ff0b9"],

Cell["\<\
First, we are going to define force components for use with \
KerrOsculatingOrbitalElements. These components need to be functions of En, \
L, K, \[Psi]r and \[Psi]\[Theta]. We\[CloseCurlyQuote]re just going to use \
the KerrGasDrag model for this example\
\>", "Text",
 CellChangeTimes->{{3.7778963875735593`*^9, 3.7778964696061974`*^9}, {
  3.7778965938261456`*^9, 3.7778966080720453`*^9}, {3.777896787159189*^9, 
  3.7778968658966036`*^9}, {3.7779011113434477`*^9, 
  3.777901183955254*^9}},ExpressionUUID->"a30224f6-381f-4464-9345-\
73b836f225c0"],

Cell["Force in covariant form", "Text",
