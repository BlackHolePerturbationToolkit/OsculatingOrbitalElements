Cell[CellGroupData[{

Cell["Information", "Subsection",
 CellChangeTimes->{{3.777897966150424*^9, 
  3.7778979696409264`*^9}},ExpressionUUID->"4d4efb2e-8b40-4fe6-87bb-\
00816738cbec"],

Cell[CellGroupData[{

Cell["Method and Notation", "Subsubsection",
 CellChangeTimes->{{3.777900740919997*^9, 
  3.7779007519494743`*^9}},ExpressionUUID->"9cc1a1c9-fbbb-4f63-9586-\
b5b6b3e138e4"],

Cell[TextData[{
 "This code used the method of Osculating Orbital Elements for Kerr first \
derived in Gair et al [3] and uses the notation given in that paper.\n\[Eta] \
is the ratio of the compact object mass to the background black hole\
\[CloseCurlyQuote]s mass.\np is the semi-lattice rectum.\ne is the \
eccentricity.\nx is Cos[\[Theta]inc].\nEn is orbital energy.\nL angular \
momentum about the symmetry axis.\nK is the modified Carter Constant defined \
by K = Q + (L - a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"En", ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "f0747028-3eb8-4d7a-9a75-82c6dadd8a79"],
 "\n\[Psi]r is the radial phase variable.\n\[Psi]\[Theta] is the polar phase \
variable.\nThe equations are integrated w.r.t Mino time \[Lambda].\nat, ar, a\
\[Theta], a\[Phi] are covariant components of the acceleration.\nft, fr, f\
\[Theta], f\[Phi] are vector components of the acceleration."
}], "Text",
 CellChangeTimes->{{3.7778966485906963`*^9, 3.7778967345030107`*^9}, {
  3.777896885975933*^9, 3.7778971110969105`*^9}, {3.7778971910560927`*^9, 
  3.7778972254082317`*^9}, {3.7778972974485884`*^9, 3.777897336872167*^9}, {
  3.777900810350279*^9, 3.7779008401755238`*^9}, {3.7779008895494933`*^9, 
  3.7779010541842446`*^9}, {3.777901411383396*^9, 3.7779014505107656`*^9}, {
  3.989640065670356*^9, 
  3.989640081601872*^9}},ExpressionUUID->"c5cd1e99-e1ec-410b-b48a-\
c3909ff98157"]
}, Open  ]],

