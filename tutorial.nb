Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SchwarzGasDrag", "[", 
  RowBox[{"p", ",", " ", "e", ",", " ", "\[Xi]"}], "]"}]], "Input",
 CellChangeTimes->{{3.777900237815273*^9, 3.7779002466805162`*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"c48bb4c4-58c7-439e-8a3b-dbcdc7f38c30"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Fr\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]], " ", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}]}]}], ",", 
   RowBox[{"\<\"F\[Phi]\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"e", " ", 
          RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
      RowBox[{"p", " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.777900247098425*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"025cc6af-0f4b-4435-bbe1-7ad9054cb1d0"]
}, Open  ]],

