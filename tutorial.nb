         PatternTest[
          Pattern[OsculatingOrbitalElements`Private`\[Eta], 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[OsculatingOrbitalElements`Private`p0, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[OsculatingOrbitalElements`Private`e0, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[OsculatingOrbitalElements`Private`\[Xi]0, 
           Blank[]], NumericQ], 
         OptionsPattern[]] :> 
       Module[{OsculatingOrbitalElements`Private`flag, 
          OsculatingOrbitalElements`Private`error, 
          OsculatingOrbitalElements`Private`Fr, 
          OsculatingOrbitalElements`Private`F\[Phi]}, 
         If[
         OsculatingOrbitalElements`Private`p0 < 
          6 + 2 OsculatingOrbitalElements`Private`e0, Message[
            MessageName[
            OsculatingOrbitalElements`SchwarzOsculatingOrbitalElements, 
             "ICs"]]; Null, Switch[
            OptionValue["Force"], {
             Blank[], 
             
             Blank[]}, {
              OsculatingOrbitalElements`Private`Fr, 
               OsculatingOrbitalElements`Private`F\[Phi]} = 
             OptionValue["Force"]; Null, 
            OsculatingOrbitalElements`SchwarzGasDrag, 
            OsculatingOrbitalElements`Private`Fr[
               Pattern[OsculatingOrbitalElements`Private`p, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`e, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`\[Xi], 
                Blank[]]] := 
             OsculatingOrbitalElements`SchwarzGasDrag[
              OsculatingOrbitalElements`Private`p, 
               OsculatingOrbitalElements`Private`e, 
               OsculatingOrbitalElements`Private`\[Xi]]["Fr"]; 
            OsculatingOrbitalElements`Private`F\[Phi][
               Pattern[OsculatingOrbitalElements`Private`p, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`e, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`\[Xi], 
                Blank[]]] := 
             OsculatingOrbitalElements`SchwarzGasDrag[
              OsculatingOrbitalElements`Private`p, 
               OsculatingOrbitalElements`Private`e, 
               OsculatingOrbitalElements`Private`\[Xi]]["F\[Phi]"]; Null, 
            OsculatingOrbitalElements`SchwarzFastGSF, If[
              Or[
              OsculatingOrbitalElements`Private`p0 > 12., 
               OsculatingOrbitalElements`Private`e0 > 0.2], Message[
                MessageName[
                OsculatingOrbitalElements`SchwarzOsculatingOrbitalElements, 
                 "OutOfRange"]]; Null]; OsculatingOrbitalElements`Private`Fr[
               Pattern[OsculatingOrbitalElements`Private`p, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`e, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`\[Xi], 
                Blank[]]] := 
             OsculatingOrbitalElements`SchwarzFastGSF[
              OsculatingOrbitalElements`Private`p, 
               OsculatingOrbitalElements`Private`e, 
               OsculatingOrbitalElements`Private`\[Xi]]["Fr"]; 
            OsculatingOrbitalElements`Private`F\[Phi][
               Pattern[OsculatingOrbitalElements`Private`p, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`e, 
                Blank[]], 
               Pattern[OsculatingOrbitalElements`Private`\[Xi], 
                Blank[]]] := 
             OsculatingOrbitalElements`SchwarzFastGSF[
              OsculatingOrbitalElements`Private`p, 
               OsculatingOrbitalElements`Private`e, 
               OsculatingOrbitalElements`Private`\[Xi]]["F\[Phi]"]; Null, 
            Blank[], Message[
              MessageName[
              OsculatingOrbitalElements`SchwarzOsculatingOrbitalElements, 
               "InvalidForce"]]; Return[]]; 
          If[OsculatingOrbitalElements`Private`e0 > 0.05, 
            OsculatingOrbitalElements`Private`SchwarzOscGeoEqs1[
            OsculatingOrbitalElements`Private`\[Eta], 
             OsculatingOrbitalElements`Private`Fr, 
             OsculatingOrbitalElements`Private`F\[Phi], 
             OsculatingOrbitalElements`Private`p0, 
             OsculatingOrbitalElements`Private`e0, 
             OsculatingOrbitalElements`Private`\[Xi]0, 
             OptionValue["IntegrationLimit"], 
             OptionValue["AccuracyGoal"], 
             OptionValue["PrecisionGoal"]], 
            OsculatingOrbitalElements`Private`SchwarzOscGeoEqs2[
            OsculatingOrbitalElements`Private`\[Eta], 
             OsculatingOrbitalElements`Private`Fr, 
             OsculatingOrbitalElements`Private`F\[Phi], 
             OsculatingOrbitalElements`Private`p0, 
             OsculatingOrbitalElements`Private`e0, 
             OsculatingOrbitalElements`Private`\[Xi]0, 
             OptionValue["IntegrationLimit"], 
             OptionValue["AccuracyGoal"], 
             OptionValue["PrecisionGoal"]]]]]}], "SubValues" -> None, 
    "DefaultValues" -> 
