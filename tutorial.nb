                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"KerrOsculatingOrbitalElementsTP", "[", 
                    
                    RowBox[{
                    "OsculatingOrbitalElements`Private`\[Eta]_", ",", 
                    "OsculatingOrbitalElements`Private`a_", ",", 
                    "OsculatingOrbitalElements`Private`p0_", ",", 
                    "OsculatingOrbitalElements`Private`e0_", ",", 
                    "OsculatingOrbitalElements`Private`x0_", ",", 
                    "OsculatingOrbitalElements`Private`\[Psi]r0_", ",", 
                    "OsculatingOrbitalElements`Private`\[Psi]\[Theta]0_", ",", 
                    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"OsculatingOrbitalElements`Private`at", ",", 
                    "OsculatingOrbitalElements`Private`ar", ",", 
                    "OsculatingOrbitalElements`Private`a\[Theta]", ",", 
                    "OsculatingOrbitalElements`Private`a\[Phi]", ",", 
                    "OsculatingOrbitalElements`Private`\[Lambda]", ",", 
                    "OsculatingOrbitalElements`Private`En", ",", 
                    "OsculatingOrbitalElements`Private`L", ",", 
                    "OsculatingOrbitalElements`Private`k", ",", 
                    "OsculatingOrbitalElements`Private`\[Psi]r", ",", 
                    "OsculatingOrbitalElements`Private`\[Psi]\[Theta]", ",", 
