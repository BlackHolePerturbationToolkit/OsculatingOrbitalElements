Cell[CellGroupData[{

Cell["User Specified Model", "Subsection",
 CellChangeTimes->{{3.7778967548077145`*^9, 
  3.7778967718970165`*^9}},ExpressionUUID->"5610dde5-87ff-41d4-a44e-\
6300ab58703f"],

Cell["\<\
First, we are going to define force components for use with \
SchwarzOsculatingOrbitalElements. These components need to be functions of p, \
e and \[Xi].\
\>", "Text",
 CellChangeTimes->{{3.7778963875735593`*^9, 3.7778964696061974`*^9}, {
  3.7778965938261456`*^9, 3.7778966080720453`*^9}, {3.777896787159189*^9, 
  3.7778968658966036`*^9}},ExpressionUUID->"397fcb91-5065-4ffd-bf34-\
54ba9b97cd60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\"\<Fr\>\"", "\[Rule]", 
   RowBox[{
    RowBox[{"-", "e"}], " ", 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"-", "6"}], "+", "p", "-", 
       RowBox[{"2", " ", "e", " ", 
        RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
      RowBox[{"p", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]], " ", 
    RowBox[{"Sin", "[", "\[Xi]", "]"}]}]}], ",", 
  RowBox[{"\"\<F\[Phi]\>\"", "\[Rule]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
     RowBox[{"p", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}]}]], "Input",ExpressionUUI\
D->"f1983934-9d15-4a9c-ba12-aae78bc5ff21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Fr", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}], 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Fr", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", 
         FractionBox[
          RowBox[{"p", "-", "r"}], 
          RowBox[{"e", " ", "r"}]]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F\[Phi]", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"e", " ", 
          RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
      RowBox[{"p", " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"F\[Phi]", "[", 
     RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"-", 
     FractionBox["p", 
      RowBox[{
       RowBox[{"r", "^", "2"}], " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.777896496002778*^9, 3.777896574256479*^9}, {
  3.777896873558111*^9, 3.7778968760624685`*^9}, {3.967612710124948*^9, 
  3.967612772841392*^9}, {3.9676128260455303`*^9, 3.967612827735581*^9}, {
  3.974897076831626*^9, 3.974897090216353*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"21d866d7-704f-4d35-981c-bf3dcad906ad"],

