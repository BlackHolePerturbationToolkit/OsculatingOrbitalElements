Cell[CellGroupData[{

Cell["Importing the Package", "Section",
 CellChangeTimes->{{3.777894772358226*^9, 
  3.7778947799194345`*^9}},ExpressionUUID->"5d3e449a-8b8b-4d2d-9061-\
54503d326dd7"],

Cell[TextData[{
 "The package is imported using the following command. This package requires \
the KerrGeodesics Package, which can be found at ",
 ButtonBox["github.com/BlackHolePerturbationToolkit/KerrGeodesics",
  BaseStyle->"Hyperlink",
  ButtonData->{"github.com/BlackHolePerturbationToolkit/KerrGeodesics", None}]
}], "Text",
 CellChangeTimes->{{3.7778947943662205`*^9, 3.777894855744747*^9}, {
  3.777896318201067*^9, 3.777896321215065*^9}, {3.7795254366395593`*^9, 
  3.7795254554542627`*^9}},ExpressionUUID->"9e04ae9d-8968-443a-894f-\
9f3e5bb6a327"],

Cell[BoxData[
 RowBox[{"<<", "OsculatingOrbitalElements`"}]], "Input",
 CellChangeTimes->{{3.967561156727145*^9, 3.9675611629192257`*^9}, 
   3.98024028573252*^9, {3.984541090657052*^9, 3.984541091319779*^9}, {
   3.984541129777795*^9, 3.984541130690733*^9}, {3.987051416904335*^9, 
   3.98705142116733*^9}, {3.989639404490775*^9, 3.9896394094860897`*^9}},
