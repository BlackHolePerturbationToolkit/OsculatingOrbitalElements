Notebook[{

Cell[CellGroupData[{
Cell["Tutorial: Using the Osculating Orbital Elements Package", "Title",
 CellChangeTimes->{{3.777894730394049*^9, 
  3.7778947553511543`*^9}},ExpressionUUID->"2db9d230-e364-497e-8868-\
575983646286"],

Cell[CellGroupData[{

Cell["Importing the Package", "Section",
 CellChangeTimes->{{3.777894772358226*^9, 
  3.7778947799194345`*^9}},ExpressionUUID->"5d3e449a-8b8b-4d2d-9061-\
54503d326dd7"],

Cell[TextData[{
 "The package is imported using the following command. This package requires \
the KerrGeodesics Package, which can be found at ",
 ButtonBox["github.com/BlackHolePerturbationToolkit/KerrGeodesics",
  BaseStyle->"Hyperlink",
  ButtonData->{"github.com/BlackHolePerturbationToolkit/KerrGeodesics", None}]
}], "Text",
 CellChangeTimes->{{3.7778947943662205`*^9, 3.777894855744747*^9}, {
  3.777896318201067*^9, 3.777896321215065*^9}, {3.7795254366395593`*^9, 
  3.7795254554542627`*^9}},ExpressionUUID->"9e04ae9d-8968-443a-894f-\
9f3e5bb6a327"],

Cell[BoxData[
 RowBox[{"<<", "OsculatingOrbitalElements`"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"e8aa9be4-ad8b-439b-922e-8db40c8befe5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Schwarzschild Spacetime", "Section",
 CellChangeTimes->{{3.7778963315114737`*^9, 3.7778963511908913`*^9}, {
  3.7779007919973593`*^9, 
  3.7779007921809015`*^9}},ExpressionUUID->"a997bb50-5192-4449-af87-\
698ab79f76a0"],

Cell[CellGroupData[{

Cell["Information", "Subsection",
 CellChangeTimes->{{3.777897966150424*^9, 
  3.7778979696409264`*^9}},ExpressionUUID->"3683a3b8-ddc3-4dd5-a39f-\
cabc810893b6"],

Cell[CellGroupData[{

Cell["Method and Notation", "Subsubsection",
 CellChangeTimes->{{3.777900740919997*^9, 
  3.7779007519494743`*^9}},ExpressionUUID->"b9e1e361-0858-4440-9600-\
2080b2c45ae4"],

Cell[TextData[{
 "This code used the method of Osculating Orbital Elements first derived in \
Pound and Poisson[1]. This code adopts the notation used in Warburton et al \
[2]. \n\[Eta] is the ratio of the compact object mass to the background black \
hole\[CloseCurlyQuote]s mass.\np is the semi-lattice rectum\ne is the \
eccentricity\n\[Xi] is the phase variable, defined by \[Xi] = \[Chi] - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "0"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "8a4e724c-416f-4fad-82b2-7f7987bae6ca"],
 ".\nThe equations are integrated w.r.t the Darwin Parameter \[Chi].\nFr and \
F\[Phi] are contrvarient componets of the acceleration."
}], "Text",
 CellChangeTimes->{{3.7778966485906963`*^9, 3.7778967345030107`*^9}, {
  3.777896885975933*^9, 3.7778971110969105`*^9}, {3.7778971910560927`*^9, 
  3.7778972254082317`*^9}, {3.7778972974485884`*^9, 
  3.777897336872167*^9}},ExpressionUUID->"92a3b029-ec27-418b-a4cf-\
5e3c4a41c6e7"]
}, Closed]],

