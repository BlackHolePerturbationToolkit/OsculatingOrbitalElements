               OsculatingOrbitalElements`Private`d\[Alpha]d\[Lambda], D[
                OsculatingOrbitalElements`Private`e[
                OsculatingOrbitalElements`Private`s], 
                OsculatingOrbitalElements`Private`s] == 
              If[OsculatingOrbitalElements`Private`minoQ, 1, 1/
                 OsculatingOrbitalElements`Private`dtd\[Lambda]] 
               OsculatingOrbitalElements`Private`ded\[Lambda]], D[
               OsculatingOrbitalElements`Private`x[
               OsculatingOrbitalElements`Private`s], 
               OsculatingOrbitalElements`Private`s] == 
             If[OsculatingOrbitalElements`Private`minoQ, 1, 1/
                OsculatingOrbitalElements`Private`dtd\[Lambda]] 
              OsculatingOrbitalElements`Private`dxd\[Lambda], 
             If[OsculatingOrbitalElements`Private`smallEQ, D[
                OsculatingOrbitalElements`Private`\[Beta]p[
                OsculatingOrbitalElements`Private`s], 
                OsculatingOrbitalElements`Private`s] == 
              If[OsculatingOrbitalElements`Private`minoQ, 1, 1/
                 OsculatingOrbitalElements`Private`dtd\[Lambda]] 
               OsculatingOrbitalElements`Private`d\[Beta]d\[Lambda], D[
                OsculatingOrbitalElements`Private`\[Psi]r[
                OsculatingOrbitalElements`Private`s], 
                OsculatingOrbitalElements`Private`s] == 
              If[OsculatingOrbitalElements`Private`minoQ, 1, 1/
                 OsculatingOrbitalElements`Private`dtd\[Lambda]] 
               OsculatingOrbitalElements`Private`d\[Psi]rd\[Lambda]], D[
               OsculatingOrbitalElements`Private`\[Psi]\[Theta][
               OsculatingOrbitalElements`Private`s], 
               OsculatingOrbitalElements`Private`s] == 
             If[OsculatingOrbitalElements`Private`minoQ, 1, 1/
                OsculatingOrbitalElements`Private`dtd\[Lambda]] 
              OsculatingOrbitalElements`Private`d\[Psi]\[Theta]d\[Lambda], D[
               OsculatingOrbitalElements`Private`\[Phi][
               OsculatingOrbitalElements`Private`s], 
               OsculatingOrbitalElements`Private`s] == 
             If[OsculatingOrbitalElements`Private`minoQ, 1, 1/
                OsculatingOrbitalElements`Private`dtd\[Lambda]] 
              OsculatingOrbitalElements`Private`d\[Phi]d\[Lambda], 
             If[OsculatingOrbitalElements`Private`minoQ, D[
                OsculatingOrbitalElements`Private`t[
                OsculatingOrbitalElements`Private`s], 
                OsculatingOrbitalElements`Private`s] == 
              OsculatingOrbitalElements`Private`dtd\[Lambda], Nothing]}, 
            If[
            OsculatingOrbitalElements`Private`smallEQ, {
             OsculatingOrbitalElements`Private`e[
               OsculatingOrbitalElements`Private`s] -> 
              Sqrt[OsculatingOrbitalElements`Private`\[Alpha]p[
                  OsculatingOrbitalElements`Private`s]^2 + 
                OsculatingOrbitalElements`Private`\[Beta]p[
                  OsculatingOrbitalElements`Private`s]^2], 
              OsculatingOrbitalElements`Private`\[Psi]r[
               OsculatingOrbitalElements`Private`s] -> ArcTan[
                OsculatingOrbitalElements`Private`\[Beta]p[
                OsculatingOrbitalElements`Private`s], 
                OsculatingOrbitalElements`Private`\[Alpha]p[
                OsculatingOrbitalElements`Private`s]]}, {}]]; 
         OsculatingOrbitalElements`Private`s = 
          If[OsculatingOrbitalElements`Private`minoQ, 
            OsculatingOrbitalElements`Private`\[Lambda], 
            OsculatingOrbitalElements`Private`t]; 
         OsculatingOrbitalElements`Private`unknowns = {
           OsculatingOrbitalElements`Private`p, 
            If[
            OsculatingOrbitalElements`Private`smallEQ, 
             OsculatingOrbitalElements`Private`\[Alpha]p, 
             OsculatingOrbitalElements`Private`e], 
            OsculatingOrbitalElements`Private`x, 
            If[
            OsculatingOrbitalElements`Private`smallEQ, 
             OsculatingOrbitalElements`Private`\[Beta]p, 
             OsculatingOrbitalElements`Private`\[Psi]r], 
            OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
            OsculatingOrbitalElements`Private`\[Phi], 
            If[
            OsculatingOrbitalElements`Private`minoQ, 
             OsculatingOrbitalElements`Private`t, Nothing]}; 
         OsculatingOrbitalElements`Private`limit = 
          OptionValue["IntegrationLimit"] 
           If[OsculatingOrbitalElements`Private`minoQ, 1, 10^3]; 
         OsculatingOrbitalElements`pMin = OptionValue["pMin"]; 
         OsculatingOrbitalElements`Private`pMinQ = 
          NumericQ[OsculatingOrbitalElements`pMin]; 
         OsculatingOrbitalElements`Private`deltaPSep = 
          OsculatingOrbitalElements`Private`\[Eta]; 
         OsculatingOrbitalElements`Private`pSep[
            PatternTest[
             Pattern[OsculatingOrbitalElements`Private`ee, 
              Blank[]], NumericQ], 
            PatternTest[
             Pattern[OsculatingOrbitalElements`Private`xx, 
              Blank[]], NumericQ]] := Quiet[
            KerrGeodesics`SpecialOrbits`KerrGeoSeparatrix[
            OsculatingOrbitalElements`Private`a, 
             OsculatingOrbitalElements`Private`ee, 
             OsculatingOrbitalElements`Private`xx]]; 
         OsculatingOrbitalElements`Private`events = 
          With[{OsculatingOrbitalElements`Private`u = 
             OsculatingOrbitalElements`Private`s}, {
             If[OsculatingOrbitalElements`Private`pMinQ, 
              WhenEvent[
              OsculatingOrbitalElements`Private`p[
                 OsculatingOrbitalElements`Private`u] - 
                OsculatingOrbitalElements`pMin == 0, Print["pMin reached."]; 
               "StopIntegration"], Nothing], 
             If[OsculatingOrbitalElements`Private`smallEQ, 
              WhenEvent[
              OsculatingOrbitalElements`Private`p[
                 OsculatingOrbitalElements`Private`u] - 
                OsculatingOrbitalElements`Private`pSep[
                 Sqrt[
                 OsculatingOrbitalElements`Private`\[Alpha]p[
                    OsculatingOrbitalElements`Private`u]^2 + 
                  OsculatingOrbitalElements`Private`\[Beta]p[
                    OsculatingOrbitalElements`Private`u]^2], 
                 OsculatingOrbitalElements`Private`x[
                 OsculatingOrbitalElements`Private`u]] - 
                OsculatingOrbitalElements`Private`deltaPSep == 0, 
               Print["Separatrix safety boundary reached."]; 
               "StopIntegration"], 
              WhenEvent[
               Evaluate[
               OsculatingOrbitalElements`Private`SeparatrixEqELK[
                 OsculatingOrbitalElements`Private`a, 
                  OsculatingOrbitalElements`Private`En, 
                  OsculatingOrbitalElements`Private`L, K] == (-1) 10^(-6)], 
               Print["Separatrix reached."]; "StopIntegration"]]}]; 
         Print["Starting NDSolve..."]; 
         OsculatingOrbitalElements`Private`solve[] := NDSolve[
            Evaluate[
             Join[
             OsculatingOrbitalElements`Private`initialConditions, 
              OsculatingOrbitalElements`Private`EoM, 
              OsculatingOrbitalElements`Private`events]], 
            OsculatingOrbitalElements`Private`unknowns, {
            OsculatingOrbitalElements`Private`s, 0, 
             OsculatingOrbitalElements`Private`limit}, AccuracyGoal -> 
            OptionValue["AccuracyGoal"], PrecisionGoal -> 
            OptionValue["PrecisionGoal"], 
            Method -> {"EquationSimplification" -> "Solve"}, 
            StepMonitor :> (OsculatingOrbitalElements`Private`progress = 
             OsculatingOrbitalElements`Private`s)]; 
         OsculatingOrbitalElements`Private`sol = 
          If[OsculatingOrbitalElements`Private`monitorQ, 
            Monitor[
             OsculatingOrbitalElements`Private`solve[], 
             Row[{
               If[OsculatingOrbitalElements`Private`minoQ, "\[Lambda]", "t"], 
               " = ", OsculatingOrbitalElements`Private`progress}]], 
            OsculatingOrbitalElements`Private`solve[]]; If[
           Not[
            MatchQ[OsculatingOrbitalElements`Private`sol, {{
               BlankSequence[Rule]}}]], Message[
             MessageName[
             OsculatingOrbitalElements`GenericKerrpexBL, "nosol"]]; 
           Return[$Failed]]; 
         OsculatingOrbitalElements`Private`rules = 
          First[OsculatingOrbitalElements`Private`sol]; {
           OsculatingOrbitalElements`Private`psol, 
            OsculatingOrbitalElements`Private`xsol, 
            OsculatingOrbitalElements`Private`\[Psi]\[Theta]sol, 
            OsculatingOrbitalElements`Private`\[Phi]sol} = 
          ReplaceAll[{
            OsculatingOrbitalElements`Private`p, 
             OsculatingOrbitalElements`Private`x, 
             OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
             OsculatingOrbitalElements`Private`\[Phi]}, 
            OsculatingOrbitalElements`Private`rules]; 
         If[OsculatingOrbitalElements`Private`minoQ, 
           OsculatingOrbitalElements`Private`tsol = 
           ReplaceAll[
            OsculatingOrbitalElements`Private`t, 
             OsculatingOrbitalElements`Private`rules], 
           OsculatingOrbitalElements`Private`tsol[
             PatternTest[
              Pattern[OsculatingOrbitalElements`Private`\[Tau], 
               Blank[]], NumericQ]] := 
           OsculatingOrbitalElements`Private`\[Tau]]; If[Part[
             OsculatingOrbitalElements`Private`psol["Domain"], 1, 2] == 
           OsculatingOrbitalElements`Private`limit, 
           Print["Limit reached."]]; 
         If[OsculatingOrbitalElements`Private`smallEQ, {
             OsculatingOrbitalElements`Private`\[Alpha]psol, 
              OsculatingOrbitalElements`Private`\[Beta]psol} = 
            ReplaceAll[{
              OsculatingOrbitalElements`Private`\[Alpha]p, 
               OsculatingOrbitalElements`Private`\[Beta]p}, 
              OsculatingOrbitalElements`Private`rules]; 
           OsculatingOrbitalElements`Private`esol[
              PatternTest[
               Pattern[OsculatingOrbitalElements`Private`u, 
                Blank[]], NumericQ]] := 
            Sqrt[OsculatingOrbitalElements`Private`\[Alpha]psol[
                OsculatingOrbitalElements`Private`u]^2 + 
              OsculatingOrbitalElements`Private`\[Beta]psol[
                OsculatingOrbitalElements`Private`u]^2]; 
           OsculatingOrbitalElements`Private`\[Psi]rsol[
              PatternTest[
               Pattern[OsculatingOrbitalElements`Private`u, 
                Blank[]], NumericQ]] := ArcTan[
              OsculatingOrbitalElements`Private`\[Beta]psol[
              OsculatingOrbitalElements`Private`u], 
              OsculatingOrbitalElements`Private`\[Alpha]psol[
              OsculatingOrbitalElements`Private`u]], {
            OsculatingOrbitalElements`Private`esol, 
             OsculatingOrbitalElements`Private`\[Psi]rsol} = 
           ReplaceAll[{
             OsculatingOrbitalElements`Private`e, 
              OsculatingOrbitalElements`Private`\[Psi]r}, 
             OsculatingOrbitalElements`Private`rules]]; 
         OsculatingOrbitalElements`Private`zmsol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          1 - OsculatingOrbitalElements`Private`xsol[
            OsculatingOrbitalElements`Private`u]^2; 
         OsculatingOrbitalElements`Private`rsol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          OsculatingOrbitalElements`Private`psol[
            OsculatingOrbitalElements`Private`u]/(1 + 
           OsculatingOrbitalElements`Private`esol[
             OsculatingOrbitalElements`Private`u] Cos[
              OsculatingOrbitalElements`Private`\[Psi]rsol[
              OsculatingOrbitalElements`Private`u]]); 
         OsculatingOrbitalElements`Private`\[Theta]sol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := ArcCos[Sqrt[
              OsculatingOrbitalElements`Private`zmsol[
              OsculatingOrbitalElements`Private`u]] Cos[
              OsculatingOrbitalElements`Private`\[Psi]\[Theta]sol[
              OsculatingOrbitalElements`Private`u]]]; 
         OsculatingOrbitalElements`Private`Ensol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          OsculatingOrbitalElements`Energy[
           OsculatingOrbitalElements`Private`a, 
            OsculatingOrbitalElements`Private`psol[
            OsculatingOrbitalElements`Private`u], 
            OsculatingOrbitalElements`Private`esol[
            OsculatingOrbitalElements`Private`u], 
            OsculatingOrbitalElements`Private`xsol[
            OsculatingOrbitalElements`Private`u]]; 
         OsculatingOrbitalElements`Private`Lsol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          OsculatingOrbitalElements`AngularMomentum[
           OsculatingOrbitalElements`Private`a, 
            OsculatingOrbitalElements`Private`psol[
            OsculatingOrbitalElements`Private`u], 
            OsculatingOrbitalElements`Private`esol[
            OsculatingOrbitalElements`Private`u], 
            OsculatingOrbitalElements`Private`xsol[
            OsculatingOrbitalElements`Private`u]]; 
         OsculatingOrbitalElements`Private`Qsol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          OsculatingOrbitalElements`Private`CarterConstant[
           OsculatingOrbitalElements`Private`a, 
            OsculatingOrbitalElements`Private`psol[
            OsculatingOrbitalElements`Private`u], 
            OsculatingOrbitalElements`Private`esol[
            OsculatingOrbitalElements`Private`u], 
            OsculatingOrbitalElements`Private`xsol[
            OsculatingOrbitalElements`Private`u]]; 
         OsculatingOrbitalElements`Private`Ksol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          OsculatingOrbitalElements`Private`Qsol[
            OsculatingOrbitalElements`Private`u] + (
             OsculatingOrbitalElements`Private`Lsol[
              OsculatingOrbitalElements`Private`u] - 
             OsculatingOrbitalElements`Private`a 
             OsculatingOrbitalElements`Private`Ensol[
              OsculatingOrbitalElements`Private`u])^2; 
         OsculatingOrbitalElements`Private`r1sol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          OsculatingOrbitalElements`Private`psol[
            OsculatingOrbitalElements`Private`u]/(1 - 
           OsculatingOrbitalElements`Private`esol[
           OsculatingOrbitalElements`Private`u]); 
         OsculatingOrbitalElements`Private`r2sol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          OsculatingOrbitalElements`Private`psol[
            OsculatingOrbitalElements`Private`u]/(1 + 
           OsculatingOrbitalElements`Private`esol[
            OsculatingOrbitalElements`Private`u]); 
         OsculatingOrbitalElements`Private`\[Iota]sol[
            Pattern[OsculatingOrbitalElements`Private`u, 
             Blank[]]] := 
          ArcCos[OsculatingOrbitalElements`Private`Lsol[
             OsculatingOrbitalElements`Private`u]/Sqrt[
            OsculatingOrbitalElements`Private`Ksol[
              OsculatingOrbitalElements`Private`u] + 
             2 OsculatingOrbitalElements`Private`a 
              OsculatingOrbitalElements`Private`Lsol[
               OsculatingOrbitalElements`Private`u] 
              OsculatingOrbitalElements`Private`Ensol[
               OsculatingOrbitalElements`Private`u] - 
             OsculatingOrbitalElements`Private`a^2 
             OsculatingOrbitalElements`Private`Ensol[
               OsculatingOrbitalElements`Private`u]^2]]; <|
          "t" -> OsculatingOrbitalElements`Private`tsol, "r" -> 
           OsculatingOrbitalElements`Private`rsol, "\[Theta]" -> 
           OsculatingOrbitalElements`Private`\[Theta]sol, "\[Phi]" -> 
           OsculatingOrbitalElements`Private`\[Phi]sol, "En" -> 
           OsculatingOrbitalElements`Private`Ensol, "L" -> 
           OsculatingOrbitalElements`Private`Lsol, "K" -> 
           OsculatingOrbitalElements`Private`Ksol, "Q" -> 
           OsculatingOrbitalElements`Private`Qsol, "p" -> 
           OsculatingOrbitalElements`Private`psol, "e" -> 
           OsculatingOrbitalElements`Private`esol, "x" -> 
           OsculatingOrbitalElements`Private`xsol, "\[Iota]" -> 
           OsculatingOrbitalElements`Private`\[Iota]sol, "\[Psi]r" -> 
           OsculatingOrbitalElements`Private`\[Psi]rsol, "\[Psi]\[Theta]" -> 
           OsculatingOrbitalElements`Private`\[Psi]\[Theta]sol, "r1" -> 
           OsculatingOrbitalElements`Private`r1sol, "r2" -> 
           OsculatingOrbitalElements`Private`r2sol, "z1" -> 
           OsculatingOrbitalElements`Private`zmsol, "limit" -> Part[
             OsculatingOrbitalElements`Private`psol["Domain"], 1, 2]|>]}], 
    "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
    "FormatValues" -> None, 
    "Options" -> {
     OsculatingOrbitalElements`IntegrationLimit -> 10000, AccuracyGoal -> 
      Automatic, PrecisionGoal -> Automatic, OsculatingOrbitalElements`Force -> 
      OsculatingOrbitalElements`KerrGasDrag, 
      OsculatingOrbitalElements`Parametrisation -> 
      OsculatingOrbitalElements`CoordinateTime, 
      OsculatingOrbitalElements`ForceUpDown -> "Down", 
      OsculatingOrbitalElements`TimeMonitor -> True, 
      OsculatingOrbitalElements`pMin -> None}, "Attributes" -> {}, "FullName" -> 
    "OsculatingOrbitalElements`GenericKerrpexBL"|>, False]]], "Output",
 CellChangeTimes->{3.997434364676606*^9, 3.9974346226473618`*^9, 
  3.99743470297304*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"b3d0d025-5983-45d9-becf-70cfb8721cf7"]
}, Open  ]],

