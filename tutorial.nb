Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Fr\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "e"}], " ", 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"-", "6"}], "+", "p", "-", 
        RowBox[{"2", " ", "e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "-", 
          SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]], " ", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}]}]}], ",", 
   RowBox[{"\<\"F\[Phi]\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"e", " ", 
          RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
      RowBox[{"p", " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.777900247098425*^9, 3.783100176707225*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"5a3ebcb1-53ac-4b5d-8cca-bead6e614274"]
