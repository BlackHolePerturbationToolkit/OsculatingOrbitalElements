          OsculatingOrbitalElements`Private`a\[Phi], 
          OsculatingOrbitalElements`Private`\[Lambda], 
          OsculatingOrbitalElements`Private`En, 
          OsculatingOrbitalElements`Private`L, 
          OsculatingOrbitalElements`Private`k, 
          OsculatingOrbitalElements`Private`\[Psi]r, 
          OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
          OsculatingOrbitalElements`Private`t, 
          OsculatingOrbitalElements`Private`\[Phi], 
          OsculatingOrbitalElements`Private`En0, 
          OsculatingOrbitalElements`Private`L0, 
          OsculatingOrbitalElements`Private`K0, 
          OsculatingOrbitalElements`Private`Q0, 
          OsculatingOrbitalElements`Private`ICs, 
          OsculatingOrbitalElements`Private`Ensol, 
          OsculatingOrbitalElements`Private`Lsol, 
          OsculatingOrbitalElements`Private`Ksol, 
          OsculatingOrbitalElements`Private`Qsol, 
          OsculatingOrbitalElements`Private`\[Psi]rsol, 
          OsculatingOrbitalElements`Private`\[Psi]\[Theta]sol, 
          OsculatingOrbitalElements`Private`tsol, 
          OsculatingOrbitalElements`Private`\[Phi]sol, 
          OsculatingOrbitalElements`Private`r1sol, 
          OsculatingOrbitalElements`Private`r2sol, 
          OsculatingOrbitalElements`Private`psol, 
          OsculatingOrbitalElements`Private`esol, 
          OsculatingOrbitalElements`Private`rsol, 
          OsculatingOrbitalElements`Private`\[Theta]sol, 
          OsculatingOrbitalElements`Private`\[Iota]sol, 
          OsculatingOrbitalElements`Private`zmsol, 
          OsculatingOrbitalElements`Private`xsol, 
          OsculatingOrbitalElements`Private`zsol, 
          OsculatingOrbitalElements`Private`Equations, 
          OsculatingOrbitalElements`Private`p, 
          OsculatingOrbitalElements`Private`e, 
          OsculatingOrbitalElements`Private`\[Theta]inc, 
          OsculatingOrbitalElements`Private`\[Theta]incsol, 
          OsculatingOrbitalElements`Private`progress = 0, 
          OsculatingOrbitalElements`Private`limit}, Needs["KerrGeodesics`"]; 
         If[
           OsculatingOrbitalElements`Private`KerrGeoBoundOrbitQ[
           OsculatingOrbitalElements`Private`a, 
            OsculatingOrbitalElements`Private`p0, 
            OsculatingOrbitalElements`Private`e0, 
            OsculatingOrbitalElements`Private`x0], {
             OsculatingOrbitalElements`Private`En0, 
              OsculatingOrbitalElements`Private`L0, 
              OsculatingOrbitalElements`Private`Q0} = 
            OsculatingOrbitalElements`Private`KerrGeoConstantsOfMotion[
             OsculatingOrbitalElements`Private`a, 
              OsculatingOrbitalElements`Private`p0, 
              OsculatingOrbitalElements`Private`e0, 
              OsculatingOrbitalElements`Private`x0]; 
           OsculatingOrbitalElements`Private`K0 = 
            OsculatingOrbitalElements`Private`Q0 + (
               OsculatingOrbitalElements`Private`L0 - 
               OsculatingOrbitalElements`Private`a 
               OsculatingOrbitalElements`Private`En0)^2; 
           OsculatingOrbitalElements`Private`ICs = {
             OsculatingOrbitalElements`Private`En[0] == 
              OsculatingOrbitalElements`Private`En0, 
              OsculatingOrbitalElements`Private`L[0] == 
              OsculatingOrbitalElements`Private`L0, 
              OsculatingOrbitalElements`Private`k[0] == 
              OsculatingOrbitalElements`Private`K0, 
              OsculatingOrbitalElements`Private`\[Psi]r[0] == 
              OsculatingOrbitalElements`Private`\[Psi]r0, 
              OsculatingOrbitalElements`Private`\[Psi]\[Theta][0] == 
              OsculatingOrbitalElements`Private`\[Psi]\[Theta]0, 
              OsculatingOrbitalElements`Private`t[0] == 0, 
              OsculatingOrbitalElements`Private`\[Phi][0] == 0}; Switch[
             OptionValue["Force"], {
              Blank[], 
              Blank[], 
              Blank[], 
              
              Blank[]}, {
               OsculatingOrbitalElements`Private`at, 
                OsculatingOrbitalElements`Private`ar, 
                OsculatingOrbitalElements`Private`a\[Theta], 
                OsculatingOrbitalElements`Private`a\[Phi]} = 
              OptionValue["Force"]; Null, 
             OsculatingOrbitalElements`KerrGasDrag, 
             OsculatingOrbitalElements`Private`at[
                Pattern[OsculatingOrbitalElements`Private`a1, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`En, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`L, 
                 Blank[]], 
                Pattern[K, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]r, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
                 Blank[]]] := 
              OsculatingOrbitalElements`KerrGasDrag[
               OsculatingOrbitalElements`Private`a1, 
                OsculatingOrbitalElements`Private`En, 
                OsculatingOrbitalElements`Private`L, K, 
                OsculatingOrbitalElements`Private`\[Psi]r, 
                OsculatingOrbitalElements`Private`\[Psi]\[Theta]]["at"]; 
             OsculatingOrbitalElements`Private`ar[
                Pattern[OsculatingOrbitalElements`Private`a1, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`En, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`L, 
                 Blank[]], 
                Pattern[K, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]r, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
                 Blank[]]] := 
              OsculatingOrbitalElements`KerrGasDrag[
               OsculatingOrbitalElements`Private`a1, 
                OsculatingOrbitalElements`Private`En, 
                OsculatingOrbitalElements`Private`L, K, 
                OsculatingOrbitalElements`Private`\[Psi]r, 
                OsculatingOrbitalElements`Private`\[Psi]\[Theta]]["ar"]; 
             OsculatingOrbitalElements`Private`a\[Theta][
                Pattern[OsculatingOrbitalElements`Private`a1, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`En, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`L, 
                 Blank[]], 
                Pattern[K, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]r, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
                 Blank[]]] := 
              OsculatingOrbitalElements`KerrGasDrag[
               OsculatingOrbitalElements`Private`a1, 
                OsculatingOrbitalElements`Private`En, 
                OsculatingOrbitalElements`Private`L, K, 
                OsculatingOrbitalElements`Private`\[Psi]r, 
                OsculatingOrbitalElements`Private`\[Psi]\[Theta]][
               "a\[Theta]"]; OsculatingOrbitalElements`Private`a\[Phi][
                Pattern[OsculatingOrbitalElements`Private`a1, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`En, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`L, 
                 Blank[]], 
                Pattern[K, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]r, 
                 Blank[]], 
                Pattern[OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
                 Blank[]]] := 
              OsculatingOrbitalElements`KerrGasDrag[
               OsculatingOrbitalElements`Private`a1, 
                OsculatingOrbitalElements`Private`En, 
                OsculatingOrbitalElements`Private`L, K, 
                OsculatingOrbitalElements`Private`\[Psi]r, 
                OsculatingOrbitalElements`Private`\[Psi]\[Theta]]["a\[Phi]"]; 
             Null, 
             Blank[], Message[
               MessageName[
               OsculatingOrbitalElements`KerrOsculatingOrbitalElements, 
                "InvalidForce"]]; Return[]]; 
           OsculatingOrbitalElements`Private`Equations = 
            Join[OsculatingOrbitalElements`Private`ICs, 
              OsculatingOrbitalElements`Private`KerrOscGeoEqs[
              OsculatingOrbitalElements`Private`\[Eta], 
               OsculatingOrbitalElements`Private`a, 
               OsculatingOrbitalElements`Private`En[
               OsculatingOrbitalElements`Private`\[Lambda]], 
               OsculatingOrbitalElements`Private`L[
               OsculatingOrbitalElements`Private`\[Lambda]], 
               OsculatingOrbitalElements`Private`k[
               OsculatingOrbitalElements`Private`\[Lambda]], 
               OsculatingOrbitalElements`Private`\[Psi]r[
               OsculatingOrbitalElements`Private`\[Lambda]], 
               OsculatingOrbitalElements`Private`\[Psi]\[Theta][
               OsculatingOrbitalElements`Private`\[Lambda]], 
               OsculatingOrbitalElements`Private`t[
               OsculatingOrbitalElements`Private`\[Lambda]], 
               OsculatingOrbitalElements`Private`\[Phi][
               OsculatingOrbitalElements`Private`\[Lambda]], 
               OsculatingOrbitalElements`Private`at, 
               OsculatingOrbitalElements`Private`ar, 
               OsculatingOrbitalElements`Private`a\[Theta], 
               OsculatingOrbitalElements`Private`a\[Phi], 
               OsculatingOrbitalElements`Private`\[Lambda]]]; 
           Print["Starting NDSolve..."]; 
           OsculatingOrbitalElements`Private`limit = 
            OptionValue[
             "IntegrationLimit"]; {{
              OsculatingOrbitalElements`Private`Ensol, 
               OsculatingOrbitalElements`Private`Lsol, 
               OsculatingOrbitalElements`Private`Ksol, 
               OsculatingOrbitalElements`Private`\[Psi]rsol, 
               OsculatingOrbitalElements`Private`\[Psi]\[Theta]sol, 
               OsculatingOrbitalElements`Private`tsol, 
               OsculatingOrbitalElements`Private`\[Phi]sol}} = Quiet[
              Monitor[
               
               ReplaceAll[{
                OsculatingOrbitalElements`Private`En, 
                 OsculatingOrbitalElements`Private`L, 
                 OsculatingOrbitalElements`Private`k, 
                 OsculatingOrbitalElements`Private`\[Psi]r, 
                 OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
                 OsculatingOrbitalElements`Private`t, 
                 OsculatingOrbitalElements`Private`\[Phi]}, 
                NDSolve[
                OsculatingOrbitalElements`Private`Equations, {
                 OsculatingOrbitalElements`Private`En, 
                  OsculatingOrbitalElements`Private`L, 
                  OsculatingOrbitalElements`Private`k, 
                  OsculatingOrbitalElements`Private`\[Psi]r, 
                  OsculatingOrbitalElements`Private`\[Psi]\[Theta], 
                  OsculatingOrbitalElements`Private`t, 
                  OsculatingOrbitalElements`Private`\[Phi]}, {
                 OsculatingOrbitalElements`Private`\[Lambda], 0, 
                  OsculatingOrbitalElements`Private`limit}, 
                 Method -> {"EquationSimplification" -> "Solve"}, 
                 AccuracyGoal -> OptionValue["AccuracyGoal"], PrecisionGoal -> 
                 OptionValue["PrecisionGoal"], 
                 StepMonitor :> (OsculatingOrbitalElements`Private`progress = 
                  OsculatingOrbitalElements`Private`\[Lambda])]], 
               "\[Lambda] = " <> 
               ToString[OsculatingOrbitalElements`Private`progress]]]; If[Part[
               OsculatingOrbitalElements`Private`Ensol["Domain"], 1, 2] < 
             OsculatingOrbitalElements`Private`limit, 
             Print["Unbound orbit encountered."]; Null]; 
           OsculatingOrbitalElements`Private`Qsol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := 
            OsculatingOrbitalElements`Private`Ksol[
              OsculatingOrbitalElements`Private`\[Lambda]] - (
              OsculatingOrbitalElements`Private`Lsol[
               OsculatingOrbitalElements`Private`\[Lambda]] - 
              OsculatingOrbitalElements`Private`a 
              OsculatingOrbitalElements`Private`Ensol[
               OsculatingOrbitalElements`Private`\[Lambda]])^2; 
           OsculatingOrbitalElements`Private`r1sol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := 
            OsculatingOrbitalElements`Private`NumRoot1[
             OsculatingOrbitalElements`Private`a, 
              OsculatingOrbitalElements`Private`Ensol[
              OsculatingOrbitalElements`Private`\[Lambda]], 
              OsculatingOrbitalElements`Private`Lsol[
              OsculatingOrbitalElements`Private`\[Lambda]], 
              OsculatingOrbitalElements`Private`Ksol[
              OsculatingOrbitalElements`Private`\[Lambda]]]; 
           OsculatingOrbitalElements`Private`r2sol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := 
            OsculatingOrbitalElements`Private`NumRoot2[
             OsculatingOrbitalElements`Private`a, 
              OsculatingOrbitalElements`Private`Ensol[
              OsculatingOrbitalElements`Private`\[Lambda]], 
              OsculatingOrbitalElements`Private`Lsol[
              OsculatingOrbitalElements`Private`\[Lambda]], 
              OsculatingOrbitalElements`Private`Ksol[
              OsculatingOrbitalElements`Private`\[Lambda]]]; 
           OsculatingOrbitalElements`Private`psol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := (2 
              OsculatingOrbitalElements`Private`r1sol[
               OsculatingOrbitalElements`Private`\[Lambda]] 
              OsculatingOrbitalElements`Private`r2sol[
               OsculatingOrbitalElements`Private`\[Lambda]])/(
             OsculatingOrbitalElements`Private`r1sol[
              OsculatingOrbitalElements`Private`\[Lambda]] + 
             OsculatingOrbitalElements`Private`r2sol[
              OsculatingOrbitalElements`Private`\[Lambda]]); 
           OsculatingOrbitalElements`Private`esol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := (
              OsculatingOrbitalElements`Private`r1sol[
               OsculatingOrbitalElements`Private`\[Lambda]] - 
              OsculatingOrbitalElements`Private`r2sol[
              OsculatingOrbitalElements`Private`\[Lambda]])/(
             OsculatingOrbitalElements`Private`r1sol[
              OsculatingOrbitalElements`Private`\[Lambda]] + 
             OsculatingOrbitalElements`Private`r2sol[
              OsculatingOrbitalElements`Private`\[Lambda]]); 
           OsculatingOrbitalElements`Private`rsol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := 
            OsculatingOrbitalElements`Private`psol[
              OsculatingOrbitalElements`Private`\[Lambda]]/(1 + 
             OsculatingOrbitalElements`Private`esol[
               OsculatingOrbitalElements`Private`\[Lambda]] Cos[
                OsculatingOrbitalElements`Private`\[Psi]rsol[
                OsculatingOrbitalElements`Private`\[Lambda]]]); 
           OsculatingOrbitalElements`Private`zmsol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := 
            1 (2 OsculatingOrbitalElements`Private`a^2 (1 - 
                OsculatingOrbitalElements`Private`Ensol[
                OsculatingOrbitalElements`Private`\[Lambda]]))^(-1) ((
               OsculatingOrbitalElements`Private`Lsol[
                 OsculatingOrbitalElements`Private`\[Lambda]]^2 + 
               OsculatingOrbitalElements`Private`Qsol[
                OsculatingOrbitalElements`Private`\[Lambda]] + 
               OsculatingOrbitalElements`Private`a^2 (1 - 
                 OsculatingOrbitalElements`Private`Ensol[
                 OsculatingOrbitalElements`Private`\[Lambda]])) - 
              Sqrt[(OsculatingOrbitalElements`Private`Lsol[
                   OsculatingOrbitalElements`Private`\[Lambda]]^2 + 
                 OsculatingOrbitalElements`Private`Qsol[
                  OsculatingOrbitalElements`Private`\[Lambda]] + 
                 OsculatingOrbitalElements`Private`a^2 (1 - 
                   OsculatingOrbitalElements`Private`Ensol[
                   OsculatingOrbitalElements`Private`\[Lambda]]))^2 - 4 
               OsculatingOrbitalElements`Private`a^2 (1 - 
                OsculatingOrbitalElements`Private`Ensol[
                OsculatingOrbitalElements`Private`\[Lambda]]) 
               OsculatingOrbitalElements`Private`Qsol[
                OsculatingOrbitalElements`Private`\[Lambda]]]); 
           OsculatingOrbitalElements`Private`xsol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := 
            Sqrt[1 - OsculatingOrbitalElements`Private`zmsol[
              OsculatingOrbitalElements`Private`\[Lambda]]]; 
           OsculatingOrbitalElements`Private`\[Theta]sol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := ArcCos[Sqrt[
                OsculatingOrbitalElements`Private`zmsol[
                OsculatingOrbitalElements`Private`\[Lambda]]] Cos[
                OsculatingOrbitalElements`Private`\[Psi]\[Theta]sol[
                OsculatingOrbitalElements`Private`\[Lambda]]]]; 
           OsculatingOrbitalElements`Private`\[Iota]sol[
              Pattern[OsculatingOrbitalElements`Private`\[Lambda], 
               Blank[]]] := 
            ArcCos[OsculatingOrbitalElements`Private`Lsol[
               OsculatingOrbitalElements`Private`\[Lambda]]/Sqrt[
              OsculatingOrbitalElements`Private`Ksol[
                OsculatingOrbitalElements`Private`\[Lambda]] + 
               2 OsculatingOrbitalElements`Private`a 
                OsculatingOrbitalElements`Private`Lsol[
                 OsculatingOrbitalElements`Private`\[Lambda]] 
                OsculatingOrbitalElements`Private`Ensol[
                 OsculatingOrbitalElements`Private`\[Lambda]] - 
               OsculatingOrbitalElements`Private`a^2 
               OsculatingOrbitalElements`Private`Ensol[
                 OsculatingOrbitalElements`Private`\[Lambda]]^2]]; <|
            "t" -> OsculatingOrbitalElements`Private`tsol, "r" -> 
             OsculatingOrbitalElements`Private`rsol, "\[Theta]" -> 
             OsculatingOrbitalElements`Private`\[Theta]sol, "\[Phi]" -> 
             OsculatingOrbitalElements`Private`\[Phi]sol, "En" -> 
             OsculatingOrbitalElements`Private`Ensol, "L" -> 
             OsculatingOrbitalElements`Private`Lsol, "K" -> 
             OsculatingOrbitalElements`Private`Ksol, "Q" -> 
             OsculatingOrbitalElements`Private`Qsol, "p" -> 
             OsculatingOrbitalElements`Private`psol, "e" -> 
             OsculatingOrbitalElements`Private`esol, "x" -> 
             OsculatingOrbitalElements`Private`xsol, "\[Iota]" -> 
             OsculatingOrbitalElements`Private`\[Iota]sol, "\[Psi]r" -> 
             OsculatingOrbitalElements`Private`\[Psi]rsol, "\[Psi]\[Theta]" -> 
             OsculatingOrbitalElements`Private`\[Psi]\[Theta]sol, "r1" -> 
             OsculatingOrbitalElements`Private`r1sol, "r2" -> 
             OsculatingOrbitalElements`Private`r2sol, "z1" -> 
             OsculatingOrbitalElements`Private`zmsol|>, Message[
             MessageName[
             OsculatingOrbitalElements`KerrOsculatingOrbitalElements, "ICs"]]; 
           Null]]}], "SubValues" -> None, "DefaultValues" -> 
    Information`InformationValueForm[
     DefaultValues, OsculatingOrbitalElements`KerrOsculatingOrbitalElements, {
      SyntaxInformation[
        OsculatingOrbitalElements`KerrOsculatingOrbitalElements] -> {
        "ArgumentsPattern" -> {
           Blank[], 
