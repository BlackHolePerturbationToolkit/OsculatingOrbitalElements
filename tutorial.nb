Cell[CellGroupData[{

Cell["SchwarzFastGSF", "Subsubsection",
 CellChangeTimes->{{3.777900507808236*^9, 
  3.777900521310133*^9}},ExpressionUUID->"f460114b-127b-4745-ac61-\
2dbe0b4f33b8"],

Cell["\<\
One can also choose to use SchwarzFastGSF model. Note that this model is \
valid for p <= 12 and e<= 0.2. \
\>", "Text",
 CellChangeTimes->{{3.777900257718998*^9, 3.7779002614939528`*^9}, {
  3.777900305863256*^9, 3.777900333061581*^9}, {3.7779003812616777`*^9, 
  3.777900471277921*^9}},ExpressionUUID->"94059512-1db7-4963-b965-\
fe4f5e883387"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "SchwarzFastGSF"}]], "Input",
 CellChangeTimes->{{3.7779004773815994`*^9, 3.7779004789354453`*^9}, {
  3.7779005247210636`*^9, 3.7779005272074127`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"eb19d428-7049-4f90-b85b-f532dbbf26f9"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox["\<\" Symbol\"\>", "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"SchwarzFastGSF[p,e,\[Xi]] returns Fr and F\[Phi] in \
terms of p, e, and \[Xi]. \\nThis function is accurate to first order for p < \
12 and e< 0.2\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[GridBox[{
             {
              
              DynamicModuleBox[{System`InformationDump`open$$ = {
               False, False, False, False, False, False, False, False, False, 
                False, False, False}}, 
               StyleBox[GridBox[{
                  {
                   TagBox[
                    TooltipBox[
                    StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                    StripOnInput->False],
                    "\"Definitions\"",
                    TooltipStyle->"TextStyling"],
                    Annotation[#, "Definitions", "Tooltip"]& ], GridBox[{
                    {
                    RowBox[{
                    RowBox[{"SchwarzFastGSF", "[", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`p_", ",", 
                    "OsculatingOrbitalElements`Private`e_", ",", 
                    "OsculatingOrbitalElements`Private`\[Xi]_", ",", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`M_", ":", "1"}]}], 
                    "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`FrCons", ",", 
                    "OsculatingOrbitalElements`Private`FrDiss", ",", 
                    "OsculatingOrbitalElements`Private`F\[Phi]Cons", ",", 
                    "OsculatingOrbitalElements`Private`F\[Phi]Diss", ",", 
                    "OsculatingOrbitalElements`Private`nmax", ",", 
                    "OsculatingOrbitalElements`Private`jbar", ",", 
                    "OsculatingOrbitalElements`Private`kbar", ",", 
                    "OsculatingOrbitalElements`Private`ki", ",", 
                    "OsculatingOrbitalElements`Private`a", ",", 
                    "OsculatingOrbitalElements`Private`b", ",", 
                    "OsculatingOrbitalElements`Private`c", ",", 
                    "OsculatingOrbitalElements`Private`d", ",", 
                    "OsculatingOrbitalElements`Private`dataA", ",", 
                    "OsculatingOrbitalElements`Private`dataB", ",", 
                    "OsculatingOrbitalElements`Private`dataC", ",", 
                    "OsculatingOrbitalElements`Private`dataD"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"SetDirectory", "[", 
                    RowBox[{"FileNameJoin", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "$UserBaseDirectory", ",", "\<\"Applications\"\>", 
                    ",", "\<\"OsculatingOrbitalElements\"\>", 
                    ",", "\<\"DataFiles\"\>"}], "}"}], "]"}], "]"}], ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`dataA", "=", 
                    RowBox[{"Import", "[", 
                    RowBox[{"\<\"a_n_jk\"\>", ",", "\<\"Table\"\>"}], "]"}]}],
                     ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`dataB", "=", 
                    RowBox[{"Import", "[", 
                    RowBox[{"\<\"b_n_jk\"\>", ",", "\<\"Table\"\>"}], "]"}]}],
                     ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`dataC", "=", 
                    RowBox[{"Import", "[", 
                    RowBox[{"\<\"c_n_jk\"\>", ",", "\<\"Table\"\>"}], "]"}]}],
                     ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`dataD", "=", 
                    RowBox[{"Import", "[", 
                    RowBox[{"\<\"d_n_jk\"\>", ",", "\<\"Table\"\>"}], "]"}]}],
                     ";", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`nmax", "=", "7"}], ";", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`jbar", "=", "4"}], ";", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`kbar", "=", "9"}], ";", 
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`ki", "[", "1", "]"}], 
                    "=", "2"}], ";", 
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`ki", "[", "2", "]"}], 
                    "=", 
                    FractionBox["9", "2"]}], ";", 
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`ki", "[", "3", "]"}], 
                    "=", "4"}], ";", 
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`ki", "[", "4", "]"}], 
                    "=", 
                    FractionBox["11", "2"]}], ";", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`a", "[", "1", "]"}], 
                    "[", "OsculatingOrbitalElements`Private`n", "]"}], "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`dataA", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"4", "+", "OsculatingOrbitalElements`Private`n"}],
                     ",", 
                    RowBox[{
                    RowBox[{"3", "+", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`j", " ", 
                    "OsculatingOrbitalElements`Private`kbar"}], "+", 
                    RowBox[{
                    "2", " ", "OsculatingOrbitalElements`Private`j"}]}], ";;", 
                    RowBox[{"3", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"OsculatingOrbitalElements`Private`j", "+", "1"}],
                     ")"}], " ", "OsculatingOrbitalElements`Private`kbar"}], 
                    "+", 
                    RowBox[{
                    "2", " ", "OsculatingOrbitalElements`Private`j"}]}]}]}], 
                    "\[RightDoubleBracket]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`j", ",", "0", ",", 
                    "4"}], "}"}]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`n", ",", "0", ",", 
                    "OsculatingOrbitalElements`Private`nmax"}], "}"}]}], 
                    "]"}], ";", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`b", "[", "1", "]"}], 
                    "[", "OsculatingOrbitalElements`Private`n", "]"}], "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`dataB", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"4", "+", "OsculatingOrbitalElements`Private`n"}],
                     ",", 
                    RowBox[{
                    RowBox[{"3", "+", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`j", " ", 
                    "OsculatingOrbitalElements`Private`kbar"}], "+", 
                    RowBox[{"2", " ", 
                    "OsculatingOrbitalElements`Private`j"}]}], ";;", 
                    RowBox[{"3", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"OsculatingOrbitalElements`Private`j", "+", "1"}],
                     ")"}], " ", "OsculatingOrbitalElements`Private`kbar"}], 
                    "+", 
                    RowBox[{
                    "2", " ", "OsculatingOrbitalElements`Private`j"}]}]}]}], 
                    "\[RightDoubleBracket]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`j", ",", "0", ",", 
                    "4"}], "}"}]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`n", ",", "0", ",", 
                    "OsculatingOrbitalElements`Private`nmax"}], "}"}]}], 
                    "]"}], ";", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`c", "[", "1", "]"}], 
                    "[", "OsculatingOrbitalElements`Private`n", "]"}], "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    "OsculatingOrbitalElements`Private`dataC", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"4", "+", "OsculatingOrbitalElements`Private`n"}],
                     ",", 
