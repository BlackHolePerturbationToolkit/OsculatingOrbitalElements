Cell["\<\
Not specifying a Force option means that KerrOsculatingOrbitalElements uses \
the KerrGasDrag model.\
\>", "Text",
 CellChangeTimes->{{3.777902138097786*^9, 
  3.7779021530498075`*^9}},ExpressionUUID->"c8600ee9-bf05-4f9b-bd4f-\
6d58314b8726"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "KerrGasDrag"}]], "Input",
 CellChangeTimes->{{3.7779018497943025`*^9, 3.777901852329523*^9}},
 CellLabel->
  "In[117]:=",ExpressionUUID->"6472b4bd-9bd4-4376-ac5d-a337f541d03c"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox["\<\" Symbol\"\>", "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"KerrGasDrag[a,En,L,K, \[Psi]r, \[Psi]\[Theta]] \
returns covarient components of a relativistic drag force, {at,ar,a\[Theta],a\
\[Phi]}, in terms of a, En, L and K.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[GridBox[{
             {
              
              DynamicModuleBox[{System`InformationDump`open$$ = {
               False, False, False, False, False, False, False, False, False, 
                False, False, False}}, 
               StyleBox[GridBox[{
                  {
                   TagBox[
                    TooltipBox[
                    StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                    StripOnInput->False],
                    "\"Definitions\"",
                    TooltipStyle->"TextStyling"],
                    Annotation[#, "Definitions", "Tooltip"]& ], GridBox[{
                    {
                    RowBox[{
                    RowBox[{"KerrGasDrag", "[", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`a_", ",", 
                    "OsculatingOrbitalElements`Private`En_", ",", 
                    "OsculatingOrbitalElements`Private`L_", ",", "K_", ",", 
                    "OsculatingOrbitalElements`Private`\[Psi]r_", ",", 
                    "OsculatingOrbitalElements`Private`\[Psi]\[Theta]_"}], 
                    "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`ur", ",", 
                    "OsculatingOrbitalElements`Private`u\[Theta]", ",", 
                    "OsculatingOrbitalElements`Private`u\[Phi]up", ",", 
                    "OsculatingOrbitalElements`Private`utup", ",", 
                    "OsculatingOrbitalElements`Private`ut", ",", 
                    "OsculatingOrbitalElements`Private`u\[Phi]", ",", 
                    "OsculatingOrbitalElements`Private`un", ",", 
                    "OsculatingOrbitalElements`Private`uztup", ",", 
                    "OsculatingOrbitalElements`Private`uz\[Phi]up", ",", 
                    "OsculatingOrbitalElements`Private`uzt", ",", 
                    "OsculatingOrbitalElements`Private`at", ",", 
                    "OsculatingOrbitalElements`Private`ar", ",", 
                    "OsculatingOrbitalElements`Private`a\[Theta]", ",", 
                    "OsculatingOrbitalElements`Private`a\[Phi]", ",", 
                    "OsculatingOrbitalElements`Private`r1", ",", 
                    "OsculatingOrbitalElements`Private`r2", ",", 
                    "OsculatingOrbitalElements`Private`p", ",", 
                    "OsculatingOrbitalElements`Private`e", ",", 
                    "OsculatingOrbitalElements`Private`r", ",", 
                    "OsculatingOrbitalElements`Private`\[Beta]", ",", 
                    "OsculatingOrbitalElements`Private`Q", ",", 
                    "OsculatingOrbitalElements`Private`zm", ",", 
                    "OsculatingOrbitalElements`Private`zp", ",", 
                    "OsculatingOrbitalElements`Private`z", ",", 
                    "OsculatingOrbitalElements`Private`\[CapitalSigma]", ",", 
                    "OsculatingOrbitalElements`Private`\[CapitalDelta]", ",", 
                    "OsculatingOrbitalElements`Private`\[Omega]", ",", 
                    "OsculatingOrbitalElements`Private`F", ",", 
                    "OsculatingOrbitalElements`Private`\[Theta]", ",", 
                    "OsculatingOrbitalElements`Private`P", ",", 
                    "OsculatingOrbitalElements`Private`J"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"OsculatingOrbitalElements`Private`r1", "=", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"Re", "[", 
                    RowBox[{"OsculatingOrbitalElements`Private`Root1", "[", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`a", ",", 
                    "OsculatingOrbitalElements`Private`En", ",", 
                    "OsculatingOrbitalElements`Private`L", ",", "K"}], "]"}], 
                    "]"}], ",", 
                    RowBox[{"Re", "[", 
                    RowBox[{"OsculatingOrbitalElements`Private`Root2", "[", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`a", ",", 
                    "OsculatingOrbitalElements`Private`En", ",", 
                    "OsculatingOrbitalElements`Private`L", ",", "K"}], "]"}], 
                    "]"}]}], "]"}]}], ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`r2", "=", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"Re", "[", 
                    RowBox[{"OsculatingOrbitalElements`Private`Root1", "[", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`a", ",", 
                    "OsculatingOrbitalElements`Private`En", ",", 
                    "OsculatingOrbitalElements`Private`L", ",", "K"}], "]"}], 
                    "]"}], ",", 
                    RowBox[{"Re", "[", 
                    RowBox[{"OsculatingOrbitalElements`Private`Root2", "[", 
                    RowBox[{
                    "OsculatingOrbitalElements`Private`a", ",", 
                    "OsculatingOrbitalElements`Private`En", ",", 
                    "OsculatingOrbitalElements`Private`L", ",", "K"}], "]"}], 
                    "]"}]}], "]"}]}], ";", 
