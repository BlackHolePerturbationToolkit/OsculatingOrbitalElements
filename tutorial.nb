Cell[CellGroupData[{

Cell["User Specified Model", "Subsection",
 CellChangeTimes->{{3.7778967548077145`*^9, 
  3.7778967718970165`*^9}},ExpressionUUID->"4fc91180-cbf9-4fa7-b143-\
beb39f2ff0b9"],

Cell["\<\
First, we are going to define force components for use with \
KerrOsculatingOrbitalElements. These components need to be functions of En, \
L, K, \[Psi]r and \[Psi]\[Theta]. We\[CloseCurlyQuote]re just going to use \
the KerrGasDrag model for this example\
\>", "Text",
 CellChangeTimes->{{3.7778963875735593`*^9, 3.7778964696061974`*^9}, {
  3.7778965938261456`*^9, 3.7778966080720453`*^9}, {3.777896787159189*^9, 
  3.7778968658966036`*^9}, {3.7779011113434477`*^9, 
  3.777901183955254*^9}},ExpressionUUID->"a30224f6-381f-4464-9345-\
73b836f225c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"at", "[", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<at\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ar", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<ar\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a\[Theta]", "[", " ", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<a\[Theta]\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a\[Phi]", "[", 
    RowBox[{
    "a_", ",", " ", "En_", ",", " ", "L_", ",", " ", "K_", ",", " ", 
     "\[Psi]r_", ",", " ", "\[Psi]\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"KerrGasDrag", "[", 
     RowBox[{
     "a", ",", " ", "En", ",", " ", "L", ",", " ", "K", ",", " ", "\[Psi]r", 
      ",", " ", "\[Psi]\[Theta]"}], "]"}], "[", "\"\<a\[Phi]\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.777896496002778*^9, 3.777896574256479*^9}, {
   3.777896873558111*^9, 3.7778968760624685`*^9}, 3.7779011529611063`*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"cf3f3522-27ef-4fc2-8101-6e16bb4732c7"],

Cell["\<\
Next, we specify the mass ratio, the spin and the initial conditions of the \
orbit.\
\>", "Text",
 CellChangeTimes->{{3.777897131266017*^9, 3.7778971669137*^9}, {
  3.777897696040717*^9, 3.777897703133792*^9}, {3.777901365132079*^9, 
  3.777901378117352*^9}},ExpressionUUID->"16842578-bc72-40dc-a3da-\
375ad54e2a67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eta]", " ", "=", " ", 
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a0", " ", "=", " ", "0.9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", " ", "=", " ", "7"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e0", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"\[Pi]", "/", "6"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]r0", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]\[Theta]0", " ", "=", "0"}], ";"}]}], "Input",
 CellChangeTimes->{{3.7778977113188925`*^9, 3.777897719343443*^9}, {
  3.7779011943006134`*^9, 3.777901219694654*^9}, {3.777901382061829*^9, 
  3.7779013826223297`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"62ef8104-e6de-4f55-976f-5070524a16f3"],

Cell["\<\
Now we solve the osculating geodesic equations and save the result to the \
symbol \[OpenCurlyQuote]kerrOrbit\[CloseCurlyQuote]\
\>", "Text",
 CellChangeTimes->{{3.777897978510231*^9, 3.7778980400885897`*^9}, {
  3.777898122085292*^9, 3.7778981410705233`*^9}, {3.777901240767359*^9, 
  3.7779012434451675`*^9}},ExpressionUUID->"fa41d2de-c28f-4633-911b-\
b7b7bc027213"],

Cell[BoxData[
 RowBox[{"<<", "OsculatingOrbitalElements`"}]], "Input",
 CellChangeTimes->{{3.783100771990573*^9, 3.7831007820281982`*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"8e7503cd-d781-4a18-8e58-5582bb2cf9a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"kerrOrbit", " ", "=", " ", 
  RowBox[{"KerrOsculatingOrbitalElements", "[", 
   RowBox[{
   "\[Eta]", ",", "a0", ",", " ", "p0", ",", " ", "e0", ",", " ", "x0", ",", 
    " ", "\[Psi]r0", ",", " ", "\[Psi]\[Theta]0", ",", " ", 
    RowBox[{"Force", " ", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"at", ",", "ar", ",", "a\[Theta]", ",", "a\[Phi]"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.7778980538168306`*^9, 3.777898094847129*^9}, {
  3.7778981440147066`*^9, 3.777898146286625*^9}, {3.777901232450576*^9, 
  3.777901355777142*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"b0e8132b-40ff-497c-8375-455f1e7c3c01"],

