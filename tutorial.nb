                    "OsculatingOrbitalElements`Private`\[Beta]psol"}], "}"}], 
                    ",", 
                    RowBox[{
                    RowBox[{"Needs", "[", "\"KerrGeodesics`\"", "]"}], ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`minoQ", "=", 
                    RowBox[{"MatchQ", "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "\"Parametrisation\"", "]"}], 
                    ",", "\"Mino\""}], "]"}]}], ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`monitorQ", "=", 
                    RowBox[{"MatchQ", "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "\"TimeMonitor\"", "]"}], ",", 
                    RowBox[{"True", "|", "\"True\""}]}], "]"}]}], ";", 
                    RowBox[{"OsculatingOrbitalElements`Private`smallEQ", "=", 
                    RowBox[{"OsculatingOrbitalElements`Private`e0", "<", 
                    
                    RowBox[{"100", " ", 
                    "OsculatingOrbitalElements`Private`\[Eta]"}]}]}], ";", 
                    
                    RowBox[{
                    "OsculatingOrbitalElements`Private`initialConditions", 
                    "=", 
                    RowBox[{"{", 
