Cell[CellGroupData[{

Cell["User Specified Model", "Subsection",
 CellChangeTimes->{{3.7778967548077145`*^9, 
  3.7778967718970165`*^9}},ExpressionUUID->"5610dde5-87ff-41d4-a44e-\
6300ab58703f"],

Cell["\<\
First, we are going to define force components for use with \
SchwarzOsculatingOrbitalElements. These components need to be functions of p, \
e and \[Xi].\
\>", "Text",
 CellChangeTimes->{{3.7778963875735593`*^9, 3.7778964696061974`*^9}, {
  3.7778965938261456`*^9, 3.7778966080720453`*^9}, {3.777896787159189*^9, 
  3.7778968658966036`*^9}},ExpressionUUID->"397fcb91-5065-4ffd-bf34-\
54ba9b97cd60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Fr", "[", 
    RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"-", "e"}], " ", 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"-", "6"}], "+", "p", "-", 
       RowBox[{"2", " ", "e", " ", 
        RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], 
      RowBox[{"p", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         SuperscriptBox["e", "2"], "+", "p"}], ")"}]}]]]}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F\[Phi]", "[", 
    RowBox[{"p_", ",", " ", "e_", ",", " ", "\[Xi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"e", " ", 
         RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}], ")"}], "2"], 
     RowBox[{"p", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        SuperscriptBox["e", "2"], "+", "p"}]]}]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.777896496002778*^9, 3.777896574256479*^9}, {
  3.777896873558111*^9, 3.7778968760624685`*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"21d866d7-704f-4d35-981c-bf3dcad906ad"],

Cell["\<\
Next, we specify the mass ratio along with initial conditions of the orbit.\
\>", "Text",
 CellChangeTimes->{{3.777897131266017*^9, 3.7778971669137*^9}, {
  3.777897696040717*^9, 
  3.777897703133792*^9}},ExpressionUUID->"7dfcb8ac-068a-4871-9160-\
c31514fdbabc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eta]", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "5"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p0", "=", "12"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e0", "=", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Xi]0", "=", "0.0"}], ";"}]}], "Input",
 CellChangeTimes->{{3.7778977113188925`*^9, 3.777897719343443*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"f98c6850-0314-4700-b981-ed164d58aa92"],

Cell["\<\
Now we solve the osculating geodesic equations and save the result to the \
symbol \[OpenCurlyQuote]orbit\[CloseCurlyQuote]\
\>", "Text",
 CellChangeTimes->{{3.777897978510231*^9, 3.7778980400885897`*^9}, {
  3.777898122085292*^9, 
  3.7778981410705233`*^9}},ExpressionUUID->"2c922bb3-b93b-4aba-b784-\
1f6786d59a36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"orbit", " ", "=", " ", 
  RowBox[{"SchwarzOsculatingOrbitalElements", "[", 
   RowBox[{
   "\[Eta]", ",", " ", "p0", ",", " ", "e0", ",", " ", "\[Xi]0", ",", " ", 
    RowBox[{"Force", " ", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"Fr", ",", " ", "F\[Phi]"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7778980538168306`*^9, 3.777898094847129*^9}, {
  3.7778981440147066`*^9, 3.777898146286625*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"2b948c48-cb2b-489b-867a-86312dea097d"],

