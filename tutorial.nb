                    "OsculatingOrbitalElements`Private`\[Psi]r0", "]"}]}]}], 
                    ",", 
                    RowBox[{
                    
                    RowBox[{"OsculatingOrbitalElements`Private`e", "[", "0", 
                    "]"}], "\[Equal]", 
                    "OsculatingOrbitalElements`Private`e0"}]}], "]"}], ",", 
                    RowBox[{
                    
                    RowBox[{"OsculatingOrbitalElements`Private`x", "[", "0", 
