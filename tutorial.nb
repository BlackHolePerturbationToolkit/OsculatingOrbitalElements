relativistic drag force, {Fr F\[Phi]}, in terms of p, e, and \[Xi].", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, OsculatingOrbitalElements`SchwarzGasDrag, {
      OsculatingOrbitalElements`SchwarzGasDrag[
         Pattern[OsculatingOrbitalElements`Private`p, 
          Blank[]], 
         Pattern[OsculatingOrbitalElements`Private`e, 
          Blank[]], 
         Pattern[OsculatingOrbitalElements`Private`\[Xi], 
          Blank[]], 
         Optional[
          Pattern[OsculatingOrbitalElements`Private`M, 
           Blank[]], 1]] :> 
       Module[{OsculatingOrbitalElements`Private`Fr, 
          OsculatingOrbitalElements`Private`F\[Phi], 
          OsculatingOrbitalElements`Private`ur, 
          OsculatingOrbitalElements`Private`u\[Phi]}, 
         OsculatingOrbitalElements`Private`ur = 
          OsculatingOrbitalElements`Private`e 
           Sin[OsculatingOrbitalElements`Private`\[Xi]] 
           Sqrt[(OsculatingOrbitalElements`Private`p - 6 - 2 
              OsculatingOrbitalElements`Private`e 
              Cos[OsculatingOrbitalElements`Private`\[Xi]])/(
             OsculatingOrbitalElements`Private`p (
              OsculatingOrbitalElements`Private`p - 3 - 
              OsculatingOrbitalElements`Private`e^2))]; 
         OsculatingOrbitalElements`Private`u\[Phi] = (1 + 
             OsculatingOrbitalElements`Private`e 
              Cos[OsculatingOrbitalElements`Private`\[Xi]])^2/(
           OsculatingOrbitalElements`Private`p 
           OsculatingOrbitalElements`Private`M 
           Sqrt[OsculatingOrbitalElements`Private`p - 3 - 
             OsculatingOrbitalElements`Private`e^2]); <|
          "Fr" -> -OsculatingOrbitalElements`Private`ur, 
           "F\[Phi]" -> -OsculatingOrbitalElements`Private`u\[Phi]|>]}], 
